// Helper class to read LANGUAGE_ANIM.txt and register clips

class AnimRegistryLang : Object
{	
	static String L(String key)
	{
		let s = StringTable.Localize(key);
		return (s && s != key) ? s : "";  // <— ключ не найден → пусто
	}


    static void SplitCSVNames(String src, Array<String> outArr)
    {
        outArr.Clear();
        String cur = "";
        int len = int(src.Length());
        for (int i = 0; i < len; i++)
        {
            String ch = src.Mid(i, 1);  // I KNOW IT'S DEPRECATED SHUT UP
            bool sep = (ch == "," || ch == " " || ch == "\t" || ch == ";");
            if (sep)
            {
                if (cur.Length() > 0) { outArr.Push(cur); cur = ""; }
            }
            else
            {
                cur = cur .. ch; 
            }
        }
        if (cur.Length() > 0) outArr.Push(cur);
    }

    static int ParseIntSafe(String s, int def)
    {
        int sign = 1, i = 0, val = 0;
        if (s.Length() == 0) return def;

        String first = s.Mid(0,1); 
        if (first == "-" || first == "+")
        {
            sign = (first == "-") ? -1 : 1;
            i = 1;
        }

        int len = int(s.Length());
        for (; i < len; i++)
        {
            int c = int(s.ByteAt(i));  
            if (c < 48 || c > 57) return def;
            val = val * 10 + (c - 48);
        }
        return sign * val;
    }

    static void SplitCSVInts(String src, Array<int> outArr)
    {
        outArr.Clear();
        String cur = "";
        int len = int(src.Length());
        for (int i = 0; i < len; i++)
        {
            String ch = src.Mid(i, 1);
            bool sep = (ch == "," || ch == " " || ch == "\t" || ch == ";");
            if (sep)
            {
                if (cur.Length() > 0) { outArr.Push(ParseIntSafe(cur, 0)); cur = ""; }
            }
            else
            {
                cur = cur .. ch;
            }
        }
        if (cur.Length() > 0) outArr.Push(ParseIntSafe(cur, 0));
    }

	static double ParseFloatSafe(String s, double def)
	{
		if (s == "") return def;
		return s.ToDouble();
	}

	static void SplitCSVFloats(String src, Array<double> outArr)
	{
		outArr.Clear();
		String cur = "";
		int len = int(src.Length());
		for (int i = 0; i < len; i++)
		{
			String ch = src.Mid(i, 1);
			bool sep = (ch == "," || ch == " " || ch == "\t" || ch == ";");
			if (sep)
			{
				if (cur.Length() > 0) 
				{
					outArr.Push(ParseFloatSafe(cur, 0.0));
					cur = "";
				}
			}
			else cur = cur .. ch;
		}
		if (cur.Length() > 0) outArr.Push(ParseFloatSafe(cur, 0.0));
	}



    static bool ParseBool(String s)
    {
        s = s.MakeLower();
        return (s == "1" || s == "true" || s == "yes" || s == "on");
    }

    static bool StartsWithIgnoreCase(String s, String pref)
    {
        String su = s.MakeUpper();
        String pu = pref.MakeUpper();
        if (pu.Length() > su.Length()) return false;
        return su.Left(pu.Length()) == pu;
    }

    static String ResolveCharFromVoice(String voiceName)
    {
        Array<String> prefs;
        SplitCSVNames(L("$ANIMS_MAP_LIST"), prefs);
        for (int i = 0; i < prefs.Size(); i++)
        {
            String pref = prefs[i];
            if (StartsWithIgnoreCase(voiceName, pref))
            {
                String who = L("$ANIMS_MAP_" .. pref);
                if (who.Length() > 0) return who;
            }
        }
        return "";
    }

    // --- UI context methods---

    // character preload
	static ui void PreloadFor(PanelPlayer p, String who)
	{
		Array<String> names;
		SplitCSVNames(L("$ANIMS_" .. who .. "_PRELOAD"), names);

		for (int i = 0; i < names.Size(); i++)
		{
			String texName = names[i];
			TextureID id = TexMan.CheckForTexture(texName);

			if (id.IsValid())
			{
				p.frames.Push(id);
			}
		}

	}

	static int ParseDecimalDigits(String digits)
	{
		int val = 0;
		for (int i = 0; i < digits.Length(); i++)
		{
			int c = digits.ByteAt(i);
			if (c < 48 || c > 57) break; // safety, но сюда не попадём — digits уже фильтрованы
			val = val * 10 + (c - 48);
		}
		return val;
	}
	//new
	static bool ParseLeadingLettersAndNumber(String s, String &letters, int &num)
	{
		letters = ""; num = -1;

		int n = s.Length();
		int i = 0;

		// Буквенный префикс [A-Za-z]
		while (i < n)
		{
			int c = s.ByteAt(i);
			bool isAlpha = ((c >= 65 && c <= 90) || (c >= 97 && c <= 122));
			if (!isAlpha) break;
			letters = letters .. s.Mid(i, 1);
			i++;
		}

		// Цифры (всегда десятичные)
		String digits = "";
		while (i < n)
		{
			int c = s.ByteAt(i);
			if (c < 48 || c > 57) break;
			digits = digits .. s.Mid(i, 1);
			i++;
		}
		if (digits.Length() == 0) return false;

		// ВАЖНО: не ToInt(), а наш десятичный парсер
		num = ParseDecimalDigits(digits);
		return true;
	}


	// ANIMS_RANGE_MAP_LIST = "GN"
	// ANIMS_RANGE_MAP_GN   = "1-50:GN1,51-100:GN2,101-150:GN3,151-200:GN4"
	static String ResolveCharFromVoiceByRanges(String clear)
	{
		String letters; int number;
		bool ok = ParseLeadingLettersAndNumber(clear, letters, number);
		String lettersU = letters.MakeUpper();

		// --- ключевые логи ввода/языка ---
		String listStr = L("$ANIMS_RANGE_MAP_LIST");
		String specStr = L("$ANIMS_RANGE_MAP_" .. lettersU);

		if (!ok) return "";

		Array<String> series;
		SplitCSVNames(listStr, series);
		bool listed = false;
		for (int i=0;i<series.Size();i++)
			if (series[i].MakeUpper() == lettersU) { listed = true; break; }

		if (!listed) {return ""; }

		String spec = specStr;
		if (spec.Length() == 0) {return ""; }

		// разбор "1-5:GN1,6-8:GN2,..."
		String cur = "";
		int len = spec.Length();
		Array<String> items;
		for (int i=0;i<len;i++)
		{
			String ch = spec.Mid(i,1);
			if (ch == ",") { if (cur.Length()>0) { items.Push(cur); cur=""; } }
			else if (ch == " " || ch == "\t" || ch == "\r" || ch == "\n") { /* skip */ }
			else cur = cur .. ch;
		}
		if (cur.Length()>0) items.Push(cur);

		String picked = "";
		for (int k=0;k<items.Size();k++)
		{
			String it = items[k]; // "1-5:GN1"
			int colon = it.IndexOf(":");
			if (colon < 0) {continue; }
			String left = it.Left(colon);   // "1-5"
			String who  = it.Mid(colon+1);  // "GN1"

			int dash = left.IndexOf("-");
			if (dash < 0) {continue; }
			int a = left.Left(dash).ToInt();
			int b = left.Mid(dash+1).ToInt();
			if (a > b) { int t=a; a=b; b=t; }

			bool hit = (number >= a && number <= b);

			if (hit) { picked = who; break; }
		}
		return picked;
	}

	static String ResolveCharFromVoiceExact(String clear)
	{
		Array<String> names; SplitCSVNames(L("$ANIMS_NAME_MAP_LIST"), names);
		for (int i=0;i<names.Size();i++)
		{
			String key = names[i];
			if (key == clear)
			{
				String who = L("$ANIMS_NAME_MAP_" .. key);
				if (who.Length() > 0) return who;
			}
		}
		return "";
	}

	static String ResolveCharFromVoiceSmart(String clear)
	{
		String u = clear.MakeUpper();
		String who = ResolveCharFromVoiceByRanges(u);
		if (who.Length() > 0) return who;

		who = ResolveCharFromVoiceExact(u);
		if (who.Length() > 0) return who;

		who = ResolveCharFromVoice(u);
		return who;
	}


	static ui void RegisterFor(PanelPlayer p, String who, bool prefix = true)
	{
		Array<String> clips;
		SplitCSVNames(L("$ANIMS_" .. who .. "_LIST"), clips);

		for (int ci = 0; ci < clips.Size(); ci++)
		{
			String clip = clips[ci].MakeUpper();
			String base = "$ANIMS_" .. who .. "_" .. clip;

			String sF = L(base .. "_FRAMES");
			String sD = L(base .. "_DURS");
			if (sF.Length() == 0 || sD.Length() == 0) continue;

			bool   loopFlag = ParseBool(L(base .. "_LOOP"));
			bool   stopFlag = ParseBool(L(base .. "_STOP"));
			String regName  = prefix ? (who .. "." .. clip) : clip;

			bool hasGroups = (sF.IndexOf("(") >= 0) || (sD.IndexOf("(") >= 0);

			if (hasGroups)
			{
				p.DefineAnimationTemplate(regName, sF, sD, loopFlag, stopFlag);
			}
			else
			{
				Array<String> f; SplitCSVNames(sF, f);
				Array<double> d; SplitCSVFloats(sD, d);
				int n = min(f.Size(), d.Size());
				while (f.Size() > n) f.Pop();
				while (d.Size() > n) d.Pop();
				p.DefineAnimationByNames(regName, f, d, loopFlag, stopFlag);
			}
		}
	}

}
