// ============================================================================
// zscript/backstabber.zc — Silent takedown / dash backstab (with fallback scan)
// ============================================================================

class PlayerWithBackstab : DoomPlayer
// was used for testing purposes. Refer to actors/walker_bs.txt
{
    default { 
		Player.StartItem "Backstabber";
		Player.StartItem "BackstabberBinder";	
	}
}

class BackstabberBinder : Inventory
{
    int onCount, offCount;

    default { Inventory.MaxAmount 1; +INVENTORY.UNDROPPABLE +INVENTORY.INVBAR }

    override void Tick()
    {
        Super.Tick();
        PlayerPawn p = PlayerPawn(Owner);
        if (p == null) return;

        Backstabber b = Backstabber(p.FindInventory('Backstabber'));
        if (b == null) { ClearAll(p); return; }	
		// crowbar only
        bool isCrow = IsCrowbarEquipped(p);      
        bool isAtk  = (p.player != null) &&      
                      (((p.player.buttons & BT_ATTACK) != 0) ||
                       ((p.player.buttons & BT_ALTATTACK) != 0));

        Actor targ;
        bool canNow = isCrow && b.CanBackstabNow(p, targ);

        if (canNow) { onCount = (onCount < 99) ? onCount+1 : 99; offCount = 0; }
        else {
            onCount = 0;
            if (!isAtk) offCount = (offCount < 99) ? offCount+1 : 99;
        }

        if (onCount >= 2) GiveIfMissing(p, 'BackstabberCan');
        if (offCount >= 16) TakeIfPresent(p, 'BackstabberCan');

        if (p.FindInventory('BackstabberRequest') != null)
        {
            p.TakeInventory('BackstabberRequest', 1);
            TakeIfPresent(p, 'BackstabberCan');
            b.Use(false);
        }
    }

    void ClearAll(PlayerPawn p)
    {
        onCount = offCount = 0;
        TakeIfPresent(p, 'BackstabberCan');
    }

    static bool IsCrowbarEquipped(PlayerPawn p)
    {
        if (p == null || p.player == null) return false;
        Weapon w = p.player.ReadyWeapon;
        if (w == null) return false;
        Name n = w.GetClassName();
        return (n == 'Crowbar_BS' || n == 'Crowbar2_BS' || n == 'Crowbar' || n == 'Crowbar2');
    }

    static void GiveIfMissing(PlayerPawn p, Name it)
    {
        if (p.FindInventory(it) == null) p.GiveInventory(it, 1);
    }
    static void TakeIfPresent(PlayerPawn p, Name it)
    {
        if (p.FindInventory(it) != null) p.TakeInventory(it, 1);
    }

    override bool Use(bool pickup) { return false; }
}

class Backstabber : Inventory
{
	double MaxPickDistance;
	double AttackDistance;
	double StopOffset;
	double ExtraClearance;
	double FOVHalfDeg;
	double BackConeHalfDeg;
	double DashSpeed;
	int    Damage;
	int    CooldownTics;

	bool   RequireSight;
	bool   RequireBackPosition;
	bool   DebugLog;

	private bool    isDashing;
	private Actor   dashTarget;
	private Vector3 dashDest;
	private int     dashTicksLeft;
	private Vector3 lastPos;

	private int cooldownCounter;

	default 
	{ 
		Inventory.MaxAmount 1;
		+INVENTORY.UNTOSSABLE
		+INVENTORY.INVBAR
	}

	override void BeginPlay()
	{
		Super.BeginPlay();
		if (MaxPickDistance <= 0) MaxPickDistance = 120.0;
		if (AttackDistance  <= 0) AttackDistance  = 70.0;
		if (StopOffset      <= 0) StopOffset      = 8.0;
		if (ExtraClearance  <= 0) ExtraClearance  = 16.0;
		if (FOVHalfDeg      <= 0) FOVHalfDeg      = 60.0;
		if (BackConeHalfDeg <= 0) BackConeHalfDeg = 45.0;
		if (DashSpeed       <= 0) DashSpeed       = 10.0;
		if (Damage          <= 0) Damage          = 80;
		if (CooldownTics    <= 0) CooldownTics    = 20;

		RequireSight = true;
		RequireBackPosition = true;
		DebugLog = false;

		cooldownCounter = 0;

		if (DebugLog) Console.Printf("[BSI] init: maxPick=%.1f atk=%.1f fov=%.1f back=%.1f stop=%.1f extra=%.1f spd=%.1f dmg=%d cd=%d",
			MaxPickDistance, AttackDistance, FOVHalfDeg, BackConeHalfDeg,
			StopOffset, ExtraClearance, DashSpeed, Damage, CooldownTics);
	}

	override void Tick()
	{
		Super.Tick();
		if (cooldownCounter > 0) cooldownCounter--;

		if (!isDashing) return;


		PlayerPawn P = PlayerPawn(Owner);
		if (P == null) { isDashing = false; return; }

		// target alive?
		if (dashTarget == null || !IsHostileCandidate(dashTarget)) {
			if (DebugLog) Console.Printf("[BSI] abort: target turned invalid");
			isDashing = false;
			P.Vel = (0,0,0);
			return;
		}

		// If target got aggroed, stop your dash
		if (dashTarget.target != null)
		{
			if (DebugLog) Console.Printf("[BSI] dash abort: target alerted mid-dash (tid=%d)", dashTarget.tid);
			P.Vel = (0,0,0);
			isDashing = false;
			return;
		}
		
		// something-something, distance, angle. Yadda-yadda, nvm
		double dx = dashTarget.Pos.x - P.Pos.x;
		double dy = dashTarget.Pos.y - P.Pos.y;
		double horiz = sqrt(dx*dx + dy*dy);
		double nx = (horiz > 1e-6) ? dx/horiz : cos(P.Angle);
		double ny = (horiz > 1e-6) ? dy/horiz : sin(P.Angle);

		double stopdist = dashTarget.Radius + P.Radius + ExtraClearance + StopOffset;
		dashDest = (dashTarget.Pos.x - nx*stopdist, dashTarget.Pos.y - ny*stopdist, P.Pos.z);

		double rdx = dashDest.x - P.Pos.x;
		double rdy = dashDest.y - P.Pos.y;
		double remain = sqrt(rdx*rdx + rdy*rdy);

		bool almostStationary = ((P.Pos - lastPos).Length() < 0.2);

		if (DebugLog)
			Console.Printf("[BSI] dash tick: remain=%.2f vel=(%.1f,%.1f) ticks=%d",
				remain, P.Vel.x, P.Vel.y, dashTicksLeft);

		// stopping dash, doing damage. No attack btw, only damage. And animation.
		if (remain <= max(2.0, DashSpeed*0.5) || dashTicksLeft <= 0 || almostStationary)
		{
			P.SetOrigin(dashDest, true);
			P.Vel = (0,0,0);

			Vector3 chest = dashTarget.Pos + (0,0, dashTarget.Height * 0.5);
			FacePoint(P, chest);
			int dealt = dashTarget.DamageMobj(P, P, Damage, 'Backstab',
				DMG_NO_ARMOR | DMG_THRUSTLESS | DMG_NO_PAIN);
			P.A_StartSound("backstab/bonk", CHAN_AUTO, 1.0, false, ATTN_NORM);

			if (DebugLog) Console.Printf("[BSI] dash hit: dealt=%d, thp=%d", dealt, dashTarget.health);

			cooldownCounter = CooldownTics;
			isDashing = false;
			return;
		}

		// dashin
		double dirx = rdx / remain;
		double diry = rdy / remain;
		P.Vel = (dirx * DashSpeed, diry * DashSpeed, 0);

		lastPos = P.Pos;
		dashTicksLeft--;
	}

	bool CanBackstabNow(PlayerPawn p, out Actor targ)
	{
		targ = PickHostileInFront(p);
		if (targ == null) return false;
		if (!IsHostileCandidate(targ)) return false;
		if (!IsTargetInRange(p, targ)) return false;
		if (RequireBackPosition && !IsPlayerBehindTarget(p, targ)) return false;
		return true;
	}


	override bool Use(bool pickup)
	{
		PlayerPawn P = PlayerPawn(Owner);
		if (DebugLog) Console.Printf("[BSI] ACTIVATE: cd=%d dash=%s", cooldownCounter, isDashing ? "on" : "off");
		if (P == null) { if (DebugLog) Console.Printf("[BSI] no player"); return false; }

		if (MaxPickDistance <= 0) MaxPickDistance = 120.0;
		if (AttackDistance  <= 0) AttackDistance  = 70.0;
		if (FOVHalfDeg      <= 0) FOVHalfDeg      = 60.0;

		if (cooldownCounter > 0) return false;

		Actor T = PickHostileInFront(P);
		if (T == null || !IsHostileCandidate(T)) {
			if (DebugLog) Console.Printf("[BSI] abort: not a hostile target");
			return false;
		}

		if (T.target != null) return false;
		if (!IsTargetInRange(P, T)) return false;
		if (RequireBackPosition && !IsPlayerBehindTarget(P, T)) return false;

		Vector3 nd = GetDirToTarget2D(P, T);
		double stopdist = T.Radius + P.Radius + ExtraClearance + StopOffset;
		Vector3 dest = (T.Pos.x - nd.x * stopdist, T.Pos.y - nd.y * stopdist, P.Pos.z);

		double destDist = (dest - P.Pos).Length();

		if (destDist <= 1.0)
		{
			// if reached point - do damage
			FacePoint(P, T.Pos + (0,0, T.Height * 0.5));
			int dealtImm = T.DamageMobj(P, P, Damage, 'Backstab',
				DMG_NO_ARMOR | DMG_THRUSTLESS | DMG_NO_PAIN);
			P.A_StartSound("backstab/hit", CHAN_BODY, 1.0, false, ATTN_NORM);
			cooldownCounter = CooldownTics;

			return true; // Success
		}
		else
		{
			if (!PerformDash(P, T, dest)) return false;
			return true; 
		}
	}

	private bool IsTargetInRange(PlayerPawn player, Actor target)
	{
		// XY-dist
		double dx = target.Pos.x - player.Pos.x;
		double dy = target.Pos.y - player.Pos.y;
		double horiz = sqrt(dx*dx + dy*dy);

		// stop dist
		double stopdist = target.Radius + player.Radius + ExtraClearance + StopOffset;

		// dist left to slide
		double toGo = max(0.0, horiz - stopdist);

		if (DebugLog) Console.Printf("[BSI] range XY: horiz=%.1f stop=%.1f toGo=%.1f (<=%.1f ? %s)",
			horiz, stopdist, toGo, AttackDistance, (toGo <= AttackDistance) ? "yes" : "no");

		return toGo <= AttackDistance;
	}


	private bool CheckPointDistance(Vector3 eye, Vector3 point, String label)
	{
		double dist = (point - eye).Length();
		bool ok = (dist <= AttackDistance);
		if (DebugLog) Console.Printf("[BSI]  range pt %-5s : dist=%.1f  (<=%.1f ? %s)", label, dist, AttackDistance, ok ? "yes" : "no");
		return ok;
	}

	// "behind the target" check
	private bool IsPlayerBehindTarget(PlayerPawn player, Actor target)
	{
		double dx = player.Pos.x - target.Pos.x;
		double dy = player.Pos.y - target.Pos.y;
		double horiz = sqrt(dx*dx + dy*dy);
		if (horiz <= 1e-6) 
		{
			if (DebugLog) Console.Printf("[BSI] backchk: zero distance");
			return false;
		}

		double nx = dx / horiz, ny = dy / horiz;
		double tx = cos(target.Angle), ty = sin(target.Angle);

		double dp = tx*nx + ty*ny;
		double needDeg = 180.0 - BackConeHalfDeg;

		double clamped = clamp(dp, -1.0, 1.0);
		double angDeg = acos(clamped) * 57.29577951308232;
		if (DebugLog) Console.Printf("[BSI] backchk: angle=%.1f° need>=%.1f° (dot=%.3f)", angDeg, needDeg, dp);

		double backConeCos = cos((180.0 - BackConeHalfDeg) * 0.017453292519943295);
		bool ok = (dp <= backConeCos);
		if (DebugLog) Console.Printf("[BSI] backchk: %s", ok ? "OK" : "FAIL");
		return ok;
	}

	private Actor PickHostileInFront(PlayerPawn pp)
	{
		// scan radius
		double radius = (MaxPickDistance > 0.0) ? MaxPickDistance : 128.0;
		if (radius < 8.0) radius = 8.0;

		double cosFov = cos(FOVHalfDeg * 0.017453292519943295); // deg->rad
		double fx = cos(pp.Angle), fy = sin(pp.Angle);

		int scanned = 0, hostile = 0, inFOV = 0, notHost = 0;
		Actor  best = null;
		double bestScore = 1e30;

		if (DebugLog) Console.Printf("[BSI] pick: start radius=%.1f", radius);

		BlockThingsIterator it = BlockThingsIterator.Create(pp, radius);
		while (it.Next())
		{
			Actor a = it.thing;
			if (a == null || a == pp) continue;
			scanned++;

			if (!IsHostileCandidate(a)) { notHost++; continue; }
			hostile++;

			if (a.target != null) {
				if (DebugLog) Console.Printf("[BSI] reject alerted (tid=%d)", a.tid);
				continue;
			}

			// if (RequireSight && !pp.CheckSight(a)) continue; 
	
			if (!IsActorInFOV(pp, a, cosFov, fx, fy)) continue;
			inFOV++;

			double dx = a.Pos.x - pp.Pos.x;
			double dy = a.Pos.y - pp.Pos.y;
			double horiz = sqrt(dx*dx + dy*dy);
			double nx = dx / max(1e-6, horiz);
			double ny = dy / max(1e-6, horiz);
			double dott = fx*nx + fy*ny;
			double score = horiz * (1.0 + (1.0 - dott));
			if (score < bestScore) { bestScore = score; best = a; }
		}

		if (scanned == 0 || best == null)
		{
			int scanned2 = 0, hostile2 = 0, inFOV2 = 0, notHost2 = 0;
			Actor  best2 = null;
			double bestScore2 = 1e30;

			if (DebugLog) Console.Printf("[BSI] pick: fallback ThinkerIterator (radius=%.1f)", radius);

			ThinkerIterator itAll = ThinkerIterator.Create("Actor");
			Actor a2;
			while ( (a2 = Actor(itAll.Next())) != null )
			{
				if (a2 == pp) continue;

				// sprite body scan
				double dx = (a2.Pos.x - pp.Pos.x);
				double dy = (a2.Pos.y - pp.Pos.y);
				double dz = (a2.Pos.z + a2.Height*0.5) - (pp.Pos.z + GetViewH(pp));
				double d3 = sqrt(dx*dx + dy*dy + dz*dz);
				if (d3 > radius) continue;
				scanned2++;

				if (!IsHostileCandidate(a2)) { notHost2++; continue; }
				hostile2++;

				if (a2.target != null) {
					if (DebugLog) Console.Printf("[BSI] reject alerted (fallback tid=%d)", a2.tid);
					continue;
				}

				// if (RequireSight && !pp.CheckSight(a2)) continue;
				if (!IsActorInFOV(pp, a2, cosFov, fx, fy)) continue;
				inFOV2++;

				double horiz = sqrt(dx*dx + dy*dy);
				double nx = dx / max(1e-6, horiz);
				double ny = dy / max(1e-6, horiz);
				double dott = fx*nx + fy*ny;
				double score = horiz * (1.0 + (1.0 - dott));
				if (score < bestScore2) { bestScore2 = score; best2 = a2; }
			}

			if (best == null) { best = best2; }
		}

		if (best != null && DebugLog)
			Console.Printf("[BSI] scan: bestTid=%d", best.tid);
		else
			Console.Printf("[BSI] scan: best=<none>");

		return best;
	}


// 	private bool IsHostileCandidate(Actor a)
// 	{
// 		if (a == null) return false;
// 		if (a.health <= 0) return false;
// 		if (!(a.bIsMonster || a.bShootable)) return false;
// 		if (a.bFriendly || a.FriendPlayer > 0) return false;
// 		return true;
// 	}

	private bool IsHostileCandidate(Actor a)
	{
		if (a == null) return false;

		if (Inventory(a) != null) return false;   // наследники Inventory
		if (a.bPickup) return false;              // всё, что можно подбирать

		if (!a.bIsMonster) return false;
		if (a.health <= 0) return false;

		if (a.bFriendly || a.FriendPlayer > 0) return false;

		if (a.target != null) return false;

		return true;
	}


	private bool IsActorInFOV(PlayerPawn player, Actor target, double cosFov, double fx, double fy)
	{
		bool ok = false;
		ok = ok || CheckPointFOV(player, target.Pos + (0,0, target.Height * 0.5), cosFov, fx, fy, "center");
		ok = ok || CheckPointFOV(player, target.Pos + (0,0, target.Height * 0.25), cosFov, fx, fy, "low");
		ok = ok || CheckPointFOV(player, target.Pos + (0,0, target.Height * 0.75), cosFov, fx, fy, "high");
		ok = ok || CheckPointFOV(player, target.Pos + ( target.Radius, 0, target.Height * 0.5), cosFov, fx, fy, "right");
		ok = ok || CheckPointFOV(player, target.Pos + (-target.Radius, 0, target.Height * 0.5), cosFov, fx, fy, "left");
		ok = ok || CheckPointFOV(player, target.Pos + (0,  target.Radius, target.Height * 0.5), cosFov, fx, fy, "front");
		ok = ok || CheckPointFOV(player, target.Pos + (0, -target.Radius, target.Height * 0.5), cosFov, fx, fy, "back");
		if (DebugLog) Console.Printf("[BSI] FOV result: %s (tid=%d)", ok ? "OK" : "FAIL", target.tid);
		return ok;
	}
	
	private bool CheckPointFOV(PlayerPawn player, Vector3 point, double cosFov, double fx, double fy, String label)
	{
		double dx = point.x - player.Pos.x;
		double dy = point.y - player.Pos.y;
		double horiz = sqrt(dx*dx + dy*dy);
		if (horiz <= 1e-6) return false;

		double nx = dx / horiz, ny = dy / horiz;
		double dott = fx*nx + fy*ny;

		bool ok = (dott >= cosFov);
		if (DebugLog) Console.Printf("[BSI]  FOV pt %-6s : dott=%.3f  (>=%.3f ? %s)", label, dott, cosFov, ok ? "yes" : "no");
		return ok;
	}

	private bool PerformDash(PlayerPawn P, Actor T, Vector3 dest)
	{
		if (P == null || T == null || T.health <= 0) return false;

		isDashing  = true;
		dashTarget = T;
		dashDest   = dest;
		lastPos    = P.Pos;

		Vector3 dv = dest - P.Pos;
		double d2d = sqrt(dv.x*dv.x + dv.y*dv.y);
		int est    = int(ceil(d2d / max(1.0, DashSpeed))) + 6;
		dashTicksLeft = min(35, max(6, est));

		double dx = dest.x - P.Pos.x;
		double dy = dest.y - P.Pos.y;
		double horiz = sqrt(dx*dx + dy*dy);
		double vx = (horiz > 1e-6) ? (dx/horiz) * DashSpeed : cos(P.Angle) * DashSpeed;
		double vy = (horiz > 1e-6) ? (dy/horiz) * DashSpeed : sin(P.Angle) * DashSpeed;
		P.Vel = (vx, vy, 0);

		if (DebugLog) Console.Printf("[BSI] dash start: dist=%.1f ticks=%d vel=(%.1f,%.1f)", d2d, dashTicksLeft, vx, vy);
		return true;
	}

	private Vector3 GetDirToTarget2D(Actor p, Actor t)
	{
		double dx = t.Pos.x - p.Pos.x;
		double dy = t.Pos.y - p.Pos.y;
		double horiz = sqrt(dx*dx + dy*dy);
		if (horiz > 1e-6) return (dx / horiz, dy / horiz, 0);
		double ang = p.Angle;
		return (cos(ang), sin(ang), 0);
	}

	private void FacePoint(Actor a, Vector3 point)
	{
		double vx = point.x - a.Pos.x;
		double vy = point.y - a.Pos.y;
		double eyeZ = a.Pos.z + GetViewH(a);
		double vz   = point.z - eyeZ;
		a.Angle = atan2(vy, vx);
		double horiz = sqrt(vx*vx + vy*vy);
		a.Pitch = (horiz > 1e-6) ? -atan2(vz, horiz) : 0.0;
	}

	private double GetViewH(Actor a)
	{
		PlayerPawn pp = PlayerPawn(a);
		if (pp != null) return pp.ViewHeight;
		return a.Height * 0.75;
	}

	private double clamp(double x, double lo, double hi)
	{
		return (x < lo) ? lo : (x > hi) ? hi : x;
	}

}
