bool DoBackstab(PlayerPawn p, Actor target)
{
  double dx, dy, dist, len, dash;
  int    baseDmg, dmg;
  Inventory tok;

  if (target == null) return false;
  if (target.health <= 0) return false;

  dx = target.Pos.x - p.Pos.x;
  dy = target.Pos.y - p.Pos.y;
  dist = sqrt(dx*dx + dy*dy);

  // Блок только по агро и только если не в упор (можно убрать вовсе, если не нужен)
  if (target.target == p && dist > 64.0)
  {
    if (DEBUG) Console.Printf("[Backstab] blocked: aggro=1 dist=%.1f", dist);
    return false;
  }

  // Повернуть игрока на цель
  p.Angle = p.AngleTo(target);

  // Нормализация
  len = dist; if (len < 1.0) len = 1.0;
  dx /= len; dy /= len;

  // Если далеко — только рывок ближе к цели, БЕЗ урона
  if (dist > AttackRange)
  {
    // подвинемся так, чтобы подойти примерно к границе удара
    double want = dist - (AttackRange - 8.0);
    if (want < 0) want = 0;
    // ограничим импульс, чтобы не “перелетать”
    if (want > 18.0) want = 18.0;
    p.Vel.x += dx * want;
    p.Vel.y += dy * want;

    // раз урон не нанесли — возвращаем false (КД не включится)
    return false;
  }

  // Здесь уже в пределах удара — наносим урон ×2
  dash = (dist <= 64.0) ? 8.0 : 12.0; // небольшой рывок для ощущения
  p.Vel.x += dx * dash;
  p.Vel.y += dy * dash;

  baseDmg = 20; // твоя базовая величина
  dmg = baseDmg * 2;
  target.DamageMobj(p, p, dmg, 'Backstab');

  A_StartSound("backstab/hit", CHAN_WEAPON, 1.0, false, ATTN_NORM);
  Spawn("Blood", target.Pos, ALLOW_REPLACE);

  target.target = p;

  tok = p.FindInventory("BackstabReady");
  if (tok != null) tok.Destroy();

  return true; // только при нанесении удара возвращаем true → включится КД
}
}
// ─────────────────────────────────────────────────────────────────────────────
// Класс игрока, чтобы выдать помощник при старте
class MyPlayer : DoomPlayer
{
  override void PostBeginPlay()
  {
    super.PostBeginPlay();
    Console.Printf("[Backstab] MyPlayer alive");
    if (FindInventory("BackstabHelper") == null) GiveInventory("BackstabHelper", 1);
  }
}
