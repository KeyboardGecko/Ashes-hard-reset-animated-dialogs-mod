// ============================================================================
// zscript/backstabber.zc — Silent takedown / dash backstab
// ============================================================================

class PlayerWithBackstab : DoomPlayer
{
	default
	{
		Player.StartItem "BackstabberInstant";
	}
}

// ============================================================================
// BackstabberInstant — однотактный бэкстаб с dash-движением
// Использование: give BackstabberInstant  /  bind v "use BackstabberInstant"
// ============================================================================

class BackstabberInstant : Inventory
{
	// Конфигурируемые параметры
	double MaxPickDistance;   // радиус сканирования (юниты)
	double AttackDistance;    // макс. стартовая дистанция (глаза -> цель, 3D)
	double StopOffset;        // базовый отступ от суммы радиусов
	double ExtraClearance;    // доп. зазор к сумме радиусов
	double FOVHalfDeg;        // половина конуса вперёд (в градусах)
	double BackConeHalfDeg;   // половина конуса сзади цели (в градусах)
	double DashSpeed;         // скорость dash-движения
	int    Damage;            // урон
	int    CooldownTics;      // время перезарядки в тиках (35 тиков = ~1 сек)
	
	bool   RequireSight;      // принудительный LOS
	bool   RequireBackPosition; // требовать позицию сзади цели
	bool   DebugLog;

	private bool    isDashing;
	private Actor   dashTarget;
	private Vector3 dashDest;
	private int     dashTicksLeft;   // защита от застревания
	private Vector3 lastPos;         // чтобы понимать, двигаемся ли

	private int cooldownCounter; // текущий счетчик кулдауна

	default 
	{ 
		Inventory.MaxAmount 1;
		+INVENTORY.UNTOSSABLE
		+INVENTORY.INVBAR  // Этот флаг важен для работы тикинга
	}

	override void BeginPlay()
	{
		Super.BeginPlay();
		// дефолты
		if (MaxPickDistance <= 0) MaxPickDistance = 128.0;
		if (AttackDistance  <= 0) AttackDistance  = 64.0;
		if (StopOffset      <= 0) StopOffset      = 8.0;
		if (ExtraClearance  <= 0) ExtraClearance  = 16.0;
		if (FOVHalfDeg      <= 0) FOVHalfDeg      = 60.0;
		if (BackConeHalfDeg <= 0) BackConeHalfDeg = 45.0;
		if (DashSpeed       <= 0) DashSpeed       = 60.0;
		if (Damage          <= 0) Damage          = 80;
		if (CooldownTics    <= 0) CooldownTics    = 300;
		
		RequireSight = true;
		RequireBackPosition = true;
		if (!DebugLog) DebugLog = false;
		
		cooldownCounter = 0;
		
	}

	override void Tick()
	{
		Super.Tick();

		// кулдаун
		if (cooldownCounter > 0) cooldownCounter--;

		// ведём даш
		if (!isDashing) return;

		PlayerPawn P = PlayerPawn(Owner);
		if (P == null) { isDashing = false; return; }

		// цель жива?
		if (dashTarget == null || dashTarget.health <= 0)
		{
			P.Vel = (0,0,0);
			isDashing = false;
			return;
		}

		// обновим целевую точку относительно текущего положения цели (держим стоп-дистанцию)
		double dx = dashTarget.Pos.x - P.Pos.x;
		double dy = dashTarget.Pos.y - P.Pos.y;
		double horiz = sqrt(dx*dx + dy*dy);
		double nx = (horiz > 1e-6) ? dx/horiz : cos(P.Angle);
		double ny = (horiz > 1e-6) ? dy/horiz : sin(P.Angle);

		double stopdist = dashTarget.Radius + P.Radius + ExtraClearance + StopOffset;
		dashDest = (dashTarget.Pos.x - nx*stopdist, dashTarget.Pos.y - ny*stopdist, P.Pos.z);

		// насколько осталось по XY
		double rdx = dashDest.x - P.Pos.x;
		double rdy = dashDest.y - P.Pos.y;
		double remain = sqrt(rdx*rdx + rdy*rdy);

		bool almostStationary = ((P.Pos - lastPos).Length() < 0.2);

		// финиш даша -> постановка + удар
		if (remain <= max(2.0, DashSpeed*0.5) || dashTicksLeft <= 0 || almostStationary)
		{
			// финальная постановка со слайдом
			P.SetOrigin(dashDest, true);
			P.Vel = (0,0,0);

			// удар
			Vector3 chest = dashTarget.Pos + (0,0, dashTarget.Height * 0.5);
			FacePoint(P, chest);
			int dealt = dashTarget.DamageMobj(P, P, Damage, 'Backstab',
				DMG_NO_ARMOR | DMG_THRUSTLESS | DMG_NO_PAIN);
			P.A_StartSound("backstab/hit", CHAN_BODY, 1.0, false, ATTN_NORM);

			if (DebugLog) Console.Printf("[BSI] dash hit: dealt=%d, thp=%d", dealt, dashTarget.health);

			cooldownCounter = CooldownTics;
			isDashing = false;
			return;
		}

		// продолжаем скользить к точке
		double dirx = rdx / remain;
		double diry = rdy / remain;
		P.Vel = (dirx * DashSpeed, diry * DashSpeed, 0);

		lastPos = P.Pos;
		dashTicksLeft--;
	}
// 	override void DoEffect()
// 	{
// 		Super.DoEffect();
// 		// Обновляем кулдаун
// 		if (cooldownCounter > 0)
// 			cooldownCounter--;
// 	}

	override bool Use(bool pickup)
	{
		PlayerPawn P = PlayerPawn(Owner);
		if (P == null) 
		{ 
			if (DebugLog) Console.Printf("[BSI] no player"); 
			return false; 
		}
		
		Console.Printf("[BSI] activate: cd=%d", cooldownCounter);

		// Проверка кулдауна
		if (cooldownCounter > 0)
		{
			if (DebugLog) Console.Printf("[BSI] on cooldown: %d tics left", cooldownCounter);
			return false;
		}

		// 1) Выбираем цель ТОЛЬКО в FOV и с LOS (расширенная проверка)
		Actor T = PickHostileInFront(P);
		if (T == null) 
		{
			if (DebugLog) Console.Printf("[BSI] no valid target found");
			return false;
		}

		// 2) Проверка стартовой дистанции (расширенная - до любой точки хитбокса)
		if (!IsTargetInRange(P, T))
		{
			if (DebugLog) Console.Printf("[BSI] target too far");
			return false;
		}

		// 3) Проверка: игрок должен быть позади цели
		if (RequireBackPosition && !IsPlayerBehindTarget(P, T))
		{
			if (DebugLog) Console.Printf("[BSI] player not behind target");
			return false;
		}

		// 4) Вычисляем конечную позицию для dash
		Vector3 nd = GetDirToTarget2D(P, T);
		double stopdist = T.Radius + P.Radius + ExtraClearance + StopOffset;
		Vector3 dest = (T.Pos.x - nd.x * stopdist, T.Pos.y - nd.y * stopdist, P.Pos.z);

		// Проверяем, что дистанция до цели не нулевая
		double destDist = (dest - P.Pos).Length();
		if (destDist <= 1.0)
		{
			if (DebugLog) Console.Printf("[BSI] already at destination");
			// Уже на месте, просто наносим удар
		}
		else
		{
			// 5) Выполняем dash к целевой позиции
// 			if (!PerformDash(P, dest))
// 			{
// 				if (DebugLog) Console.Printf("[BSI] dash failed or interrupted");
// 				return false;
// 			}
			if (!PerformDash(P, T, dest))
			{
				if (DebugLog) Console.Printf("[BSI] dash failed or interrupted");
				return false;
			}
			return false; // дальше Tick() дослайдит и ударит


		}

		// 6) Поворачиваемся к цели
		FacePoint(P, T.Pos + (0,0, T.Height * 0.5));

		if (DebugLog) Console.Printf("[BSI] dash complete: stop=%.1f nx=%.3f ny=%.3f", stopdist, nd.x, nd.y);

		// 7) Удар «тихо»
		int dealt = T.DamageMobj(P, P, Damage, 'Backstab',
			DMG_NO_ARMOR | DMG_THRUSTLESS | DMG_NO_PAIN);
		P.A_StartSound("backstab/hit", CHAN_BODY, 1.0, false, ATTN_NORM);

		if (DebugLog) Console.Printf("[BSI] HIT: dealt=%d, thp=%d", dealt, T.health);

		// 8) Устанавливаем кулдаун
		cooldownCounter = CooldownTics;

		return false; // предмет не тратим
	}

	// === НОВАЯ ФУНКЦИЯ: Проверка дистанции до любой точки хитбокса ===
	private bool IsTargetInRange(PlayerPawn player, Actor target)
	{
		Vector3 eye = player.Pos + (0,0, GetViewH(player));
		
		// Проверяем несколько точек на хитбоксе цели (вручную перебираем)
		if (CheckPointDistance(eye, target.Pos + (0,0, target.Height * 0.5))) return true;  // центр
		if (CheckPointDistance(eye, target.Pos + (0,0, target.Height * 0.25))) return true; // низ
		if (CheckPointDistance(eye, target.Pos + (0,0, target.Height * 0.75))) return true; // верх
		if (CheckPointDistance(eye, target.Pos + (target.Radius, 0, target.Height * 0.5))) return true;  // право
		if (CheckPointDistance(eye, target.Pos + (-target.Radius, 0, target.Height * 0.5))) return true; // лево
		if (CheckPointDistance(eye, target.Pos + (0, target.Radius, target.Height * 0.5))) return true;  // перед
		if (CheckPointDistance(eye, target.Pos + (0, -target.Radius, target.Height * 0.5))) return true; // зад
		
		return false;
	}
	
	// Вспомогательная функция для проверки дистанции до точки
	private bool CheckPointDistance(Vector3 eye, Vector3 point)
	{
		double dist = (point - eye).Length();
		if (dist <= AttackDistance)
		{
			if (DebugLog) Console.Printf("[BSI] target in range: dist=%.1f to test point", dist);
			return true;
		}
		return false;
	}

	// === Проверка что игрок позади цели ===
	private bool IsPlayerBehindTarget(PlayerPawn player, Actor target)
	{
		// 1) Вычисляем вектор от цели к игроку
		double dx = player.Pos.x - target.Pos.x;
		double dy = player.Pos.y - target.Pos.y;
		double horiz = sqrt(dx*dx + dy*dy);
		
		if (horiz <= 1e-6) 
		{
			if (DebugLog) Console.Printf("[BSI] zero distance to target");
			return false;
		}
		
		// Нормализуем вектор от цели к игроку
		double nx = dx / horiz;
		double ny = dy / horiz;
		
		// 2) Получаем направление взгляда цели
		double targetForwardX = cos(target.Angle);
		double targetForwardY = sin(target.Angle);
		
		// 3) Вычисляем косинус угла между направлением цели и вектором к игроку
		double dotProduct = targetForwardX * nx + targetForwardY * ny;
		
		// 4) Вычисляем косинус половины конуса сзади (180° ± BackConeHalfDeg)
		double backConeCos = cos((180.0 - BackConeHalfDeg) * 0.017453292519943295);
		
		if (DebugLog) 
		{
			double angleDeg = acos(dotProduct) * 57.29577951308232;
			Console.Printf("[BSI] back check: dot=%.3f, angle=%.1f°, required=%.1f°", 
				dotProduct, angleDeg, 180.0 - BackConeHalfDeg);
		}
		
		// Игрок считается "позади", если dotProduct <= backConeCos
		return dotProduct <= backConeCos;
	}

	// === ОБНОВЛЕННАЯ ФУНКЦИЯ: Поиск цели с расширенной проверкой FOV ===
	private Actor PickHostileInFront(PlayerPawn pp)
	{
		double radius = MaxPickDistance;
		double cosFov = cos(FOVHalfDeg * 0.017453292519943295);
		double fx = cos(pp.Angle), fy = sin(pp.Angle);

		Vector3 eye = pp.Pos + (0,0, GetViewH(pp));
		double bestScore = 1e30;
		Actor  best = null;

		// Используем BlockThingsIterator
		BlockThingsIterator it = BlockThingsIterator.Create(pp, radius);
		Actor a;
		
		while (it.Next())
		{
			a = it.thing;
			if (a == null || a == pp) continue;

			// Фильтр hostile монстров
			if (a.health <= 0) continue;
			if (!a.bIsMonster) continue;
			if (a.bFriendly || a.FriendPlayer > 0) continue;

			// НОВАЯ ПРОВЕРКА: монстр не должен быть в состоянии аггро
			if (a.target == pp) 
			{
				if (DebugLog) Console.Printf("[BSI] target is alerted: has player as target");
				continue;
			}

			// LOS проверка
			if (RequireSight && !pp.CheckSight(a)) continue;

			// РАСШИРЕННАЯ ПРОВЕРКА FOV: проверяем несколько точек хитбокса
			if (!IsActorInFOV(pp, a, cosFov, fx, fy))
				continue;

			// приоритизируем то, что ближе к центру прицела и ближе по расстоянию
			double dx = a.Pos.x - pp.Pos.x;
			double dy = a.Pos.y - pp.Pos.y;
			double horiz = sqrt(dx*dx + dy*dy);
			
			double nx = dx / horiz, ny = dy / horiz;
			double dott = fx*nx + fy*ny;

			double score = horiz * (1.0 + (1.0 - dott));

			if (score < bestScore) 
			{ 
				bestScore = score; 
				best = a; 
			}
		}

		if (DebugLog && best != null) 
			Console.Printf("[BSI] best target: %s, score=%.1f", best.GetClassName(), bestScore);
			
		return best;
	}

	// === НОВАЯ ФУНКЦИЯ: Проверка что актор в FOV по любой точке хитбокса ===
	private bool IsActorInFOV(PlayerPawn player, Actor target, double cosFov, double fx, double fy)
	{
		// Проверяем несколько точек на хитбоксе цели (вручную перебираем)
		if (CheckPointFOV(player, target.Pos + (0,0, target.Height * 0.5), cosFov, fx, fy)) return true;  // центр
		if (CheckPointFOV(player, target.Pos + (0,0, target.Height * 0.25), cosFov, fx, fy)) return true; // низ
		if (CheckPointFOV(player, target.Pos + (0,0, target.Height * 0.75), cosFov, fx, fy)) return true; // верх
		if (CheckPointFOV(player, target.Pos + (target.Radius, 0, target.Height * 0.5), cosFov, fx, fy)) return true;  // право
		if (CheckPointFOV(player, target.Pos + (-target.Radius, 0, target.Height * 0.5), cosFov, fx, fy)) return true; // лево
		if (CheckPointFOV(player, target.Pos + (0, target.Radius, target.Height * 0.5), cosFov, fx, fy)) return true;  // перед
		if (CheckPointFOV(player, target.Pos + (0, -target.Radius, target.Height * 0.5), cosFov, fx, fy)) return true; // зад
		
		return false;
	}
	
	// Вспомогательная функция для проверки FOV точки
	private bool CheckPointFOV(PlayerPawn player, Vector3 point, double cosFov, double fx, double fy)
	{
		// 2D вектор от игрока к точке на цели
		double dx = point.x - player.Pos.x;
		double dy = point.y - player.Pos.y;
		double horiz = sqrt(dx*dx + dy*dy);
		
		if (horiz <= 1e-6) return false;

		double nx = dx / horiz, ny = dy / horiz;
		double dott = fx*nx + fy*ny;

		// Если точка в FOV
		if (dott >= cosFov)
		{
			if (DebugLog) Console.Printf("[BSI] target in FOV via test point: dot=%.3f", dott);
			return true;
		}
		
		return false;
	}

