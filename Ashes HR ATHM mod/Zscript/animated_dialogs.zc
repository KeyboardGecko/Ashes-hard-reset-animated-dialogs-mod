// ============================================================
//  Dialog animation system for GZDoom (ZScript)
// ============================================================

class AthmDataSource : Object
{
	Dictionary values;
	bool loaded;
	bool valid;
	bool parseFailed;
	int formatVersion;

	static bool IsSpace(int c)
	{
		return c == 32 || c == 9 || c == 13 || c == 10;
	}

	static bool IsKeyByte(int c)
	{
		return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) ||
			(c >= 48 && c <= 57) || c == 95;
	}

	static String DecodeValue(String raw)
	{
		String result = "";
		int start = 0;
		int rawLength = raw.Length();
		for (int i = 0; i < rawLength; i++)
		{
			if (raw.ByteAt(i) != 92 || i + 1 >= rawLength) continue;
			result = result .. raw.Mid(start, i - start);
			// LANGUAGE_ANIM values are single-line. Escapes are needed only to
			// preserve a literal quote or backslash, so copying the next byte is
			// sufficient and avoids ZScript's unusual backslash-literal syntax.
			result = result .. raw.Mid(i + 1, 1);
			i++;
			start = i + 1;
		}
		return result .. raw.Mid(start);
	}

	ui bool Load()
	{
		if (loaded) return valid;
		loaded = true;
		values = Dictionary.Create();

		int lump = Wads.CheckNumForFullName("language_anim.txt");
		if (lump < 0)
		{
			Console.Printf("[ATHM] language_anim.txt was not found.\n");
			return false;
		}

		String source = Wads.ReadLump(lump);
		int length = source.Length();
		int i = 0;
		while (i < length)
		{
			while (i < length && IsSpace(source.ByteAt(i))) i++;
			if (i >= length) break;

			if (source.ByteAt(i) == 47 && i + 1 < length && source.ByteAt(i + 1) == 47)
			{
				while (i < length && source.ByteAt(i) != 10) i++;
				continue;
			}
			if (source.ByteAt(i) == 91)
			{
				while (i < length && source.ByteAt(i) != 10) i++;
				continue;
			}

			int keyStart = i;
			while (i < length && IsKeyByte(source.ByteAt(i))) i++;
			if (i == keyStart)
			{
				i++;
				continue;
			}
			String key = source.Mid(keyStart, i - keyStart).MakeUpper();
			while (i < length && IsSpace(source.ByteAt(i))) i++;
			if (i >= length || source.ByteAt(i) != 61)
			{
				Console.Printf("[ATHM] Expected '=' after %s.\n", key);
				parseFailed = true;
				while (i < length && source.ByteAt(i) != 10) i++;
				continue;
			}
			i++;
			while (i < length && IsSpace(source.ByteAt(i))) i++;
			if (i >= length || source.ByteAt(i) != 34)
			{
				Console.Printf("[ATHM] Expected quoted value for %s.\n", key);
				parseFailed = true;
				while (i < length && source.ByteAt(i) != 10) i++;
				continue;
			}
			i++;
			int valueStart = i;
			bool escaped = false;
			while (i < length)
			{
				int c = source.ByteAt(i);
				if (c == 34 && !escaped) break;
				if (c == 92 && !escaped) escaped = true;
				else escaped = false;
				i++;
			}
			if (i >= length)
			{
				Console.Printf("[ATHM] Unterminated value for %s.\n", key);
				parseFailed = true;
				break;
			}
			values.Insert(key, DecodeValue(source.Mid(valueStart, i - valueStart)));
			i++;
			while (i < length && source.ByteAt(i) != 10 && source.ByteAt(i) != 59) i++;
			if (i < length && source.ByteAt(i) == 59) i++;
		}

		formatVersion = values.At("ATHM_FORMAT").ToInt();
		valid = !parseFailed && formatVersion == 4 &&
			values.At("ATHM_CHARACTERS").Length() > 0;
		if (!valid)
		{
			if (formatVersion != 4)
				Console.Printf("[ATHM] Unsupported ATHM_FORMAT %d; expected 4.\n", formatVersion);
			else if (values.At("ATHM_CHARACTERS").Length() == 0)
				Console.Printf("[ATHM] ATHM_CHARACTERS is empty.\n");
			else Console.Printf("[ATHM] Data parsing failed; animations are disabled.\n");
			return false;
		}
		return true;
	}

	ui String Get(String key)
	{
		if (!Load()) return "";
		return values.At(key.MakeUpper());
	}
}


// Helper class: parsing + LANGUAGE access + register
class AnimRegistryLang : Object
{
	// ---------------------------
	// Fast token splitters (CSV/space/;/\t etc)
	// Avoids cur = cur .. ch (O(n^2))
	// ---------------------------
	static bool IsSepByte(int c)
	{
		return (c == 44 /*,*/ || c == 59 /*;*/ ||
				c == 32 /*space*/ || c == 9 /*\t*/ ||
				c == 13 /*\r*/ || c == 10 /*\n*/);
	}

	static void SplitCSVNames(String src, Array<String> outArr)
	{
		outArr.Clear();
		int len = src.Length();
		int start = -1;

		for (int i = 0; i <= len; i++)
		{
			bool end = (i == len);
			int c = end ? 0 : src.ByteAt(i);
			bool sep = end || IsSepByte(c);

			if (!sep)
			{
				if (start < 0) start = i;
			}
			else
			{
				if (start >= 0)
				{
					outArr.Push(src.Mid(start, i - start));
					start = -1;
				}
			}
		}
	}

	static bool ParseBool(String s)
	{
		s = s.MakeLower();
		return (s == "1" || s == "true" || s == "yes" || s == "on");
	}

	static bool StartsWithIgnoreCase(String s, String pref)
	{
		String su = s.MakeUpper();
		String pu = pref.MakeUpper();
		if (pu.Length() > su.Length()) return false;
		return su.Left(pu.Length()) == pu;
	}

	static int ParseDecimalDigits(String digits)
	{
		int val = 0;
		for (int i = 0; i < int(digits.Length()); i++)
		{
			int c = digits.ByteAt(i);
			if (c < 48 || c > 57) break;
			val = val * 10 + (c - 48);
		}
		return val;
	}

	static bool ParseLeadingLettersAndNumber(String s, String &letters, int &num)
	{
		letters = ""; num = -1;

		int n = s.Length();
		int i = 0;

		while (i < n)
		{
			int c = s.ByteAt(i);
			bool isAlpha = ((c >= 65 && c <= 90) || (c >= 97 && c <= 122));
			if (!isAlpha) break;
			letters = letters .. s.Mid(i, 1);
			i++;
		}

		String digits = "";
		while (i < n)
		{
			int c = s.ByteAt(i);
			if (c < 48 || c > 57) break;
			digits = digits .. s.Mid(i, 1);
			i++;
		}
		if (digits.Length() == 0) return false;

		num = ParseDecimalDigits(digits);
		return true;
	}

	// character preload
	static ui void PreloadFor(PanelPlayer p, String who)
	{
		// ATHM v4 resolves textures lazily from TRACK entries.
		p.SetBackground(who);
	}
	
	// Register clips for character
	static ui void RegisterFor(PanelPlayer p, String who, bool prefix = true)
	{
		Array<String> clips;
		SplitCSVNames(p.Data("ATHM_" .. who .. "_ANIMATIONS"), clips);

		for (int ci = 0; ci < clips.Size(); ci++)
		{
			String clip = clips[ci].MakeUpper();
			String base = "ATHM_" .. who .. "_" .. clip;
			String track = p.Data(base .. "_TRACK");
			if (track.Length() == 0) continue;

			bool loopFlag = ParseBool(p.Data(base .. "_LOOP"));
			double durationMs = p.Data(base .. "_DURATION_MS").ToDouble();
			String background = p.Data(base .. "_BACKGROUND");

			String regName = prefix ? (who .. "." .. clip) : clip;

			p.DefineAnimationV2(regName, track, loopFlag, true, durationMs, background);
		}
	}
}


// ============================================================
// Overlay EventHandler
// ============================================================
class DialogUIOverlay : StaticEventHandler
{
	// for syncing animation and audio
	ui Actor  pendingNpc;
	ui String pendingVoice;
	ui double pendingVol;
	ui int    pendingChan;
	ui int    pendingStartTic;
	ui bool   hasPending;

	// other stuff
	ui PanelPlayer panel;
	ui bool   bShow, inConversation;

	ui int hb;
	ui int hbTimeout;

	// for making music quieter in dialogs
	ui bool musicDuckApplied;

	ui void Heartbeat() { hb = hbTimeout; }
	ui static void HeartbeatStatic() { let o = Get(); if (o) o.Heartbeat(); }
	
	// clear image cache when changing map
	// no memory leaks now
	// although the logic is, uh, meh
	int resetStampPlay;     // play-only counter
	ui int resetStampUiSeen; // ui-only "last seen" copy of stamp


	override void WorldLoaded(WorldEvent e)
	{
		resetStampPlay++;

	}

	override void WorldUnloaded(WorldEvent e)
	{
		resetStampPlay++;
	}

	ui void Ensure()
	{
		if (hbTimeout == 0) hbTimeout = 2;

		if (panel == null)
		{
			panel = new("PanelPlayer");
			panel.PreloadOnce();
		}
	}

	ui bool ApplyPendingWorldReset()
	{
		int stamp = resetStampPlay;
		if (stamp == resetStampUiSeen) return false;

		resetStampUiSeen = stamp;
		bShow = false;
		inConversation = false;
		hb = 0;
		KillPendingSync();
		TurnMusicBack();
		if (panel) panel.HardClear();
		return true;
	}
	
	ui void KillPendingSync()
	{
		hasPending = false;
		pendingNpc = null;
		pendingVoice = "";
		pendingVol = 1.0;
		pendingChan = 0;
		pendingStartTic = 0;
		}

	ui void BeginConversation()
	{
		MakeMusicQuieter();
		inConversation = true;
	}

	ui void EndConversation()
	{
		TurnMusicBack();

		inConversation = false;

		KillPendingSync();

		if (panel) 
		{ 
			panel.OnConversationEnd(); 
			panel.Reset();
			panel.SetBackground("");
		}
		bShow = false;
	}

	ui static int SyncDelayTics()
	{
		let o = Get();
		if (!o) return 1;

		o.EnsureCVars();

		int t = 1;
		if (o.cvSyncTics) t = max(0, o.cvSyncTics.GetInt());

		return clamp(t, 0, 8);
	}


	ui void ScheduleSyncStart(Actor npc, String voice, double vol, int chan = CHAN_5)
	{
		Ensure();
		if (voice.Length() == 0)
		{
			ShowVoiceInst(""); 
			return;
		}
		pendingNpc   = npc;
		pendingVoice = voice;
		pendingVol   = clamp(vol, 0.0, 1.0);
		pendingChan  = chan;

		hasPending = (npc != null) && (voice.Length() > 0);
		pendingStartTic = level.time + SyncDelayTics();

		// PREWARM
		if (hasPending && panel)
		{
			panel.EnsureCharacterForVoice(voice); 
		}
	}

	
	ui static void ScheduleSyncStartStatic(Actor npc, String voice, double vol, int chan = CHAN_5)
	{
		let o = Get(); if (o) o.ScheduleSyncStart(npc, voice, vol, chan);
	}

	override void UiTick()
	{
		bool startedPanelThisTick = false;
		if (hb > 0) hb--;
		if (inConversation && hb == 0) EndConversation();

		if (!jm_anim_enabled)
		{
			bShow = false;
			inConversation = false;
			hasPending = false;
			if (panel) panel.Reset();
			return;
		}

		Ensure();
		
		// Do not start anything on a standalone reset tick. NewConversationMenu
		// consumes this reset before it establishes the new conversation state.
		if (ApplyPendingWorldReset()) return;

		// Single unified point: start voice+anim in same tick
		if (hasPending && level.time >= pendingStartTic)
		{
			EnsureCVars();

			bool allowVoice = true;
			if (cvVoiceEnable) allowVoice = cvVoiceEnable.GetBool();

			// Submit audio first. Starting the animation before A_StartSound is most
			// noticeable while sound data is cold immediately after loading a save.
			if (allowVoice && pendingNpc)
			{
				pendingNpc.A_StartSound(pendingVoice, pendingChan, 0, pendingVol, ATTN_NORM);
			}

			ShowVoiceInst(pendingVoice);
			startedPanelThisTick = true;

			hasPending = false;
		}

		// PlayAnim installs frame zero with its complete duration. Do not consume
		// one full 35 Hz tick at the exact moment the voice is submitted.
		if (panel && jm_anim_play && !startedPanelThisTick) panel.Tick();
		if (panel && !panel.CanDraw()) bShow = false;
	}

	override void RenderOverlay(RenderEvent e)
	{
		if (!jm_anim_enabled) return;
		if (!panel) return;

		if (!bShow || !inConversation) return;
		panel.Draw();
	}

	ui void SetFallbackBackdropInst(String tex)
	{
		Ensure();
		if (panel) panel.SetFallbackTexture(tex);
	}

	ui void ShowVoiceInst(String voice)
	{
		Ensure();
		if (!panel) { bShow = false; return; }

		bool ok = panel.PlayForVoice(voice);
		if (ok && voice.Length() > 0)
		{
			Sound voiceId = voice;
			double voiceDurationMs = S_GetLength(voiceId) * 1000.0;
			if (voiceDurationMs > 0.0)
				panel.PadCurrentSequenceToDuration(voiceDurationMs);
		}
		if (!ok) {
			ok = panel.TryStartIdle();
			if (!ok) ok = panel.PlayFallback();
		}
		panel.EnsureLiveScale();

		bShow = ok && panel.CanDraw();
		if (bShow) { inConversation = true; Heartbeat(); }
		else if (panel) { panel.Reset(); bShow = false; }
	}

// 	ui static DialogUIOverlay Get()                      { return DialogUIOverlay(StaticEventHandler.Find("DialogUIOverlay")); }
	// callable from both play and ui
	clearscope static DialogUIOverlay Get()
	{
		return DialogUIOverlay(StaticEventHandler.Find("DialogUIOverlay"));
	}

	// cached CVars (avoid FindCVar each tick)
	ui CVar cvVoiceEnable;
	ui CVar cvSyncTics;

	// one-shot init
	ui void EnsureCVars()
	{
		if (!cvVoiceEnable) cvVoiceEnable = CVar.FindCVar("jm_voice_enable");
		if (!cvSyncTics)    cvSyncTics    = CVar.FindCVar("jm_anim_sync_tics");
	}

	// play-safe query for other handlers
	clearscope static bool IsConversationActive()
	{
		let o = Get();
		return o;
	}

	ui void PlayOptionalBlockSound(String sound)
	{
		if (sound.Length() == 0) return;
		Sound soundId = sound;
		if (S_GetLength(soundId) <= 0.0)
		{
			return;
		}

		Actor source = null;
		let pl = players[consoleplayer];
		if (pl && pl.mo) source = pl.mo;
		else if (pendingNpc) source = pendingNpc;

		if (source) source.A_StartSound(soundId, CHAN_6, 0, 1.0, ATTN_NONE);
	}

	ui static void PlayOptionalBlockSoundStatic(String sound)
	{
		let o = Get(); if (o) o.PlayOptionalBlockSound(sound);
	}

	ui static bool IsAnimationLocked()
	{
		let o = Get();
		return jm_anim_enabled && jm_anim_play && o && o.panel && o.panel.IsLocked();
	}

	ui static void BeginConversationStatic()             { let o = Get(); if (o) o.BeginConversation(); }
	ui static void EndConversationStatic()     			 { let o = Get(); if (o) o.EndConversation(); }
	ui static void EnsureStatic()                        { let o = Get(); if (o) o.Ensure(); }
	ui static void PrepareConversationStatic()
	{
		let o = Get();
		if (o)
		{
			o.Ensure();
			o.ApplyPendingWorldReset();
		}
	}
	ui static void ShowVoiceStatic(String voice)         { let o = Get(); if (o) o.ShowVoiceInst(voice); }
	ui static void SetFallbackBackdropStatic(String tex) { let o = Get(); if (o) o.SetFallbackBackdropInst(tex); }

	// Music ducking (fixed naming)
	// works only if dlgduck.acs +dlduck.o is present
	// because crutches and bicycles
	ui void MakeMusicQuieter()
	{
		double targetAbs = 0.25;
		double user = 1.0;

		let cv = CVar.GetCVar('snd_musicvolume', players[consoleplayer]);
		if (cv) user = clamp(cv.GetFloat(), 0.0, 1.0);

		musicDuckApplied = false;

		if (user > targetAbs && user > 0.0)
		{
			double mult = clamp(targetAbs / user, 0.0, 2.0);
			int mult16  = int(mult * 65536.0 + 0.5);
			ACS_NamedExecuteWithResult('Dlg_SetMusicVol', mult16);
			musicDuckApplied = true;
		}
	}

	ui void TurnMusicBack()
	{
		if (musicDuckApplied)
		{
			ACS_NamedExecuteWithResult('Dlg_SetMusicVol', 65536);
			musicDuckApplied = false;
		}
	}
}


// ============================================================
// Conversation menu (NO double voice playback)
// ============================================================
class NewConversationMenu : ConversationMenu
{
	StrifeDialogueNode _prev;
	DialogUIOverlay o;
	bool pendingLockedAction;
	int pendingLockedNode;
	int pendingLockedReply;
	int pendingLockedSince;

	void ClearPendingLockedAction()
	{
		pendingLockedAction = false;
		pendingLockedNode = 0;
		pendingLockedReply = 0;
		pendingLockedSince = 0;
	}

	void SendPendingLockedAction()
	{
		if (!pendingLockedAction) return;
		int node = pendingLockedNode;
		int reply = pendingLockedReply;
		ClearPendingLockedAction();
		SendConversationReply(node, reply);
		Close();
	}

	override int Init(StrifeDialogueNode CurNode, PlayerInfo player, int activereply)
	{
		int r = Super.Init(CurNode, player, activereply);
		ClearPendingLockedAction();

		o = DialogUIOverlay.Get();
		if (!o) return r;

		// Consume a pending WorldLoaded reset before establishing any state for
		// this menu. Otherwise the first UI tick can erase the scheduled reply.
		o.PrepareConversationStatic();
		o.BeginConversationStatic();
		
		o.HeartbeatStatic();

		o.SetFallbackBackdropStatic(CurNode ? CurNode.Backdrop : "");

		// No PlayNodeVoice here. Only schedule unified start.
		let pl = players[consoleplayer];
		if (pl && pl.mo && CurNode)
		{
			let npc = pl.ConversationNPC;
			if (npc)
			{
				double vol = 1.0;
				let cvVol = CVar.GetCVar('jm_voice_volume', players[consoleplayer]);
				if (cvVol) vol = clamp(cvVol.GetFloat(), 0.0, 1.0);

				DialogUIOverlay.ScheduleSyncStartStatic(npc, CurNode.SpeakerVoice, vol, CHAN_5);
			}
			else
			{
				o.ShowVoiceStatic(CurNode.SpeakerVoice);
			}
		}
		else if (CurNode)
		{
			o.ShowVoiceStatic(CurNode.SpeakerVoice);
		}

		_prev = CurNode;
		return r;
	}

	override void Ticker()
	{
		Super.Ticker();
		o.HeartbeatStatic();
		if (pendingLockedAction && !DialogUIOverlay.IsAnimationLocked())
		{
			SendPendingLockedAction();
			return;
		}
		if (pendingLockedAction && gametic - pendingLockedSince > GameTicRate * 60)
		{
			Console.Printf("[ATHM] Locked sequence exceeded 60 seconds; releasing queued dialogue action.\n");
			SendPendingLockedAction();
			return;
		}

		if (mCurNode != _prev)
		{
			String voice = ""; 
			String backdrop = ""; 

			if (mCurNode != null) {
				voice = mCurNode.SpeakerVoice; 
				backdrop = mCurNode.Backdrop;
			}
			o.SetFallbackBackdropStatic(backdrop);

			let pl = players[consoleplayer];
			if (pl && pl.mo && mCurNode)
			{
				let npc = pl.ConversationNPC;
				if (npc)
				{
					double vol = 1.0;
					let cvVol = CVar.GetCVar('jm_voice_volume', players[consoleplayer]);
					if (cvVol) vol = clamp(cvVol.GetFloat(), 0.0, 1.0);

					DialogUIOverlay.ScheduleSyncStartStatic(npc, voice, vol, CHAN_5);
				}
				else
				{
					o.ShowVoiceStatic(voice);
				}
			}
			else
			{
				o.ShowVoiceStatic(voice);
			}

			_prev = mCurNode;
		}

		if (mCurNode == null)
		{
			o.EndConversationStatic();
		}
	}

	override bool MenuEvent(int mkey, bool fromcontroller)
	{
		// The first accepted action is already captured. Ignore all further menu
		// input until the locked animation releases it.
		if (pendingLockedAction) return true;
		if ((mkey == MKEY_Back || mkey == MKEY_Enter) &&
			DialogUIOverlay.IsAnimationLocked())
		{
			// First action wins. Capture the reply now: the selection may still move
			// while the unskippable sequence is playing.
			int selectedResponse = mSelection;
			int responseCount = mResponses.Size();
			pendingLockedAction = true;
			pendingLockedReply = GetReplyNum();
			if (mkey == MKEY_Back) pendingLockedNode = -1;
			else if (selectedResponse >= responseCount) pendingLockedNode = -2;
			else pendingLockedNode = mCurNode.ThisNodeNum;
			pendingLockedSince = gametic;
			// Immediate one-shot feedback. The deferred send below deliberately does
			// not play a sound, so the confirmation cannot repeat after the lock.
			if (mkey == MKEY_Enter) MenuSound("menu/advance");
			else MenuSound("menu/backup");
			return true;
		}
		return Super.MenuEvent(mkey, fromcontroller);
	}

	override void OnDestroy()
	{
		ClearPendingLockedAction();
		Super.OnDestroy();
	}

	override void DrawReplies()
	{
		if (pendingLockedAction) return;
		Super.DrawReplies();
	}

	override bool DrawBackdrop() { return true; }
}


// ============================================================
// Silencing original Strife dialog voice
// ============================================================

class VoiceHijack : StaticEventHandler
{
	Actor lastNpc;
	int   armTics;   // strong stop window after NPC change (covers menu open)
	int   pulse;     // periodic pulse to catch node changes without per-tick hammering

	override void WorldTick()
	{
		if (!jm_anim_enabled)
		{
			lastNpc = null;
			armTics = 0;
			pulse = 0;
			return;
		}

		let pi = players[consoleplayer];
		if (!pi)
			return;

		let npc = pi.ConversationNPC;

		if (!npc)
		{
			lastNpc = null;
			armTics = 0;
			pulse = 0;
			return;
		}

		if (npc != lastNpc)
		{
			lastNpc = npc;
			armTics = 6; // ~0.17s @35 tics
			pulse = 0;
		}

		if (armTics > 0)
		{
			npc.A_StopSound(CHAN_VOICE);
			armTics--;
			return;
		}

		pulse = (pulse + 1) & 7; // every 8 tics
		if (pulse == 0)
		{
			npc.A_StopSound(CHAN_VOICE);
		}
	}
}
 
// ============================================================
// PanelPlayer (animation playback + LANGUAGE cache stored here)
// ============================================================
class PanelPlayer : Object
{
	bool ready;
	AthmDataSource dataSource;

	Array<TextureID> frames;
	Array<String>    frameNamesLower; // cache tex names in lowercase

	Array<String> animNames;
	Array<int>    clipOffset, clipCount;
	Array<bool>   clipLoop, clipStopLast;
	Array<double> clipDurationMs;
	Array<String> clipBackground;
	Array<int>    flatFrames;
	Array<double> flatDurMs;

	int  curClip, seqPos;
	bool active;
	int  lastFrameIdx;

	int vW, vH;
	double topMargin;
	int cachedScaleIdx;

	double timeLeftMs;

	String character;
	String resolvedAnimation;
	Array<String> loadedChars;

	String fallbackTex;

	Array<bool>   clipIsTemplate;
	// Legacy template arrays remain only for old in-memory helper compatibility.
	Array<String> clipTplFrames;
	Array<String> clipTplDurs;
	Array<String> clipTplTrack;

	// temp resolved sequence for templates
	bool          useTempSeq;
	Array<int>    tempFrames;
	Array<double> tempDurMs;
	Array<bool>   tempLocked;
	Array<String> tempBlockSound;
	Array<double> tempBlockSoundOffsetMs;
	int           tempCount;
	String        pendingBlockSound;
	double        pendingBlockSoundMs;

	int lastGoodFrameIdx;

	// Runtime registry built once from ATHM v4 data.
	bool registryReady;
	Array<String> registryCharacters;
	Array<String> soundNames;
	Array<String> soundCharacters;
	Array<String> soundAnimations;
	Array<String> voicePatterns;
	Array<String> voicePatternCharacters;

	// fallback anim name -> flat slot cache
	Array<String> fbCacheName;  
	Array<int>    fbCacheOff;

	// Separate background
	ui TextureID bgTexture;
	ui String    bgName;
	ui String    characterBgName;


	ui void HardClear()
	{
		ready = false;

		Reset();

		frames.Clear();
		frameNamesLower.Clear();
		animNames.Clear();
		clipOffset.Clear();
		clipCount.Clear();
		clipLoop.Clear();
		clipStopLast.Clear();
		clipDurationMs.Clear();
		clipBackground.Clear();

		flatFrames.Clear();
		flatDurMs.Clear();

		clipIsTemplate.Clear();
		clipTplFrames.Clear();
		clipTplDurs.Clear();
		clipTplTrack.Clear();

		useTempSeq = false;
		tempFrames.Clear();
		tempDurMs.Clear();
		tempLocked.Clear();
		tempBlockSound.Clear();
		tempBlockSoundOffsetMs.Clear();
		tempCount = 0;
		pendingBlockSound = "";
		pendingBlockSoundMs = 0.0;

		loadedChars.Clear();
		character = "";
		resolvedAnimation = "";

		fallbackTex = "";

		lastGoodFrameIdx = -1;
		lastFrameIdx = -1;

		registryReady = false;
		registryCharacters.Clear();
		soundNames.Clear();
		soundCharacters.Clear();
		soundAnimations.Clear();
		voicePatterns.Clear();
		voicePatternCharacters.Clear();

		fbCacheName.Clear();
		fbCacheOff.Clear();

		cachedScaleIdx = -1;
		vW = 0; vH = 0;
		topMargin = 0.0;
		
		bgName = "";
		characterBgName = "";
		bgTexture = TexMan.CheckForTexture("", TexMan.Type_MiscPatch);
	}


	int FindFbCache(String name)
	{
		for (int i = 0; i < fbCacheName.Size(); i++)
			if (fbCacheName[i] == name) return i;
		return -1;
	}

	static String NormalizeSoundName(String path)
	{
		int slash = path.RightIndexOf("/");
		String result = (slash >= 0) ? path.Mid(slash + 1) : path;
		int extensionPos = result.RightIndexOf(".");
		if (extensionPos > 0) result = result.Left(extensionPos);
		return result.MakeUpper();
	}

	ui void EnsureRegistry()
	{
		if (registryReady) return;
		registryReady = true;
		AnimRegistryLang.SplitCSVNames(Data("ATHM_CHARACTERS"), registryCharacters);

		for (int ci = 0; ci < registryCharacters.Size(); ci++)
		{
			String who = registryCharacters[ci].MakeUpper();
			registryCharacters[ci] = who;
			String variantOf = Data("ATHM_" .. who .. "_VARIANT_OF").MakeUpper();
			if (variantOf.Length() > 0) continue;

			Array<String> animations;
			AnimRegistryLang.SplitCSVNames(Data("ATHM_" .. who .. "_ANIMATIONS"), animations);
			if (animations.Size() == 0)
				Console.Printf("[ATHM] Character %s has no animations.\n", who);
			for (int ai = 0; ai < animations.Size(); ai++)
			{
				String animation = animations[ai].MakeUpper();
				if (animation == "IDLE") continue;
				String soundName = Data("ATHM_" .. who .. "_" .. animation .. "_SOUND");
				if (soundName.Length() == 0) continue;
				String normalizedSound = NormalizeSoundName(soundName);
				int previousSound = IndexOfStr(soundNames, normalizedSound);
				if (previousSound >= 0)
				{
					Console.Printf("[ATHM] Sound %s has multiple animations; keeping %s.%s.\n",
						normalizedSound, soundCharacters[previousSound], soundAnimations[previousSound]);
					continue;
				}
				soundNames.Push(normalizedSound);
				soundCharacters.Push(who);
				soundAnimations.Push(animation);
			}

			Array<String> patterns;
			AnimRegistryLang.SplitCSVNames(Data("ATHM_" .. who .. "_VOICE_MATCH"), patterns);
			for (int pi = 0; pi < patterns.Size(); pi++)
			{
				voicePatterns.Push(patterns[pi].MakeUpper());
				voicePatternCharacters.Push(who);
			}
		}
	}

	static bool MatchesVoicePattern(String voice, String pattern)
	{
		int len = pattern.Length();
		if (len == 0) return false;
		if (pattern.ByteAt(len - 1) == 42)
			return AnimRegistryLang.StartsWithIgnoreCase(voice, pattern.Left(len - 1));

		int dash = pattern.IndexOf("-");
		if (dash > 0)
		{
			bool foundDigit = false;
			int voiceLength = voice.Length();
			for (int vi = 0; vi < voiceLength; vi++)
			{
				int vc = voice.ByteAt(vi);
				bool letter = vc >= 65 && vc <= 90;
				bool digit = vc >= 48 && vc <= 57;
				if (digit) foundDigit = true;
				else if (!letter || foundDigit) return false;
			}
			if (!foundDigit) return false;
			String firstLetters, lastLetters, voiceLetters;
			int firstNumber, lastNumber, voiceNumber;
			if (!AnimRegistryLang.ParseLeadingLettersAndNumber(pattern.Left(dash), firstLetters, firstNumber)) return false;
			if (!AnimRegistryLang.ParseLeadingLettersAndNumber(pattern.Mid(dash + 1), lastLetters, lastNumber)) return false;
			if (!AnimRegistryLang.ParseLeadingLettersAndNumber(voice, voiceLetters, voiceNumber)) return false;
			if (firstLetters.MakeUpper() != lastLetters.MakeUpper() ||
				firstLetters.MakeUpper() != voiceLetters.MakeUpper()) return false;
			if (firstNumber > lastNumber) { int swap = firstNumber; firstNumber = lastNumber; lastNumber = swap; }
			return voiceNumber >= firstNumber && voiceNumber <= lastNumber;
		}
		return voice == pattern;
	}

	static int VoicePatternSpecificity(String pattern)
	{
		int len = pattern.Length();
		if (len > 0 && pattern.ByteAt(len - 1) == 42) return len - 1;
		if (pattern.IndexOf("-") > 0) return 10000 + len;
		return 20000 + len;
	}

	ui String ResolveCharFromVoiceSmart(String clear)
	{
		EnsureRegistry();
		String wanted = NormalizeSoundName(clear);
		resolvedAnimation = "";
		for (int i = 0; i < soundNames.Size(); i++)
		{
			if (soundNames[i] == wanted)
			{
				resolvedAnimation = soundAnimations[i];
				return soundCharacters[i];
			}
		}
		String best = "";
		int bestSpecificity = -1;
		for (int i = 0; i < voicePatterns.Size(); i++)
		{
			if (!MatchesVoicePattern(wanted, voicePatterns[i])) continue;
			int specificity = VoicePatternSpecificity(voicePatterns[i]);
			if (specificity > bestSpecificity)
			{
				bestSpecificity = specificity;
				best = voicePatternCharacters[i];
			}
		}
		if (best.Length() > 0) resolvedAnimation = "IDLE";
		return best;
	}

	ui String Data(String key)
	{
		if (!dataSource) dataSource = new("AthmDataSource");
		return dataSource.Get(key);
	}

	// --------------------------------------------------

	static bool StringEndsWith(String s, String suffix)
	{
		int sl = s.Length();
		int tl = suffix.Length();
		if (tl == 0) return true;
		if (sl < tl) return false;
		return s.Mid(sl - tl) == suffix;
	}

	static bool IsIdleName(String n)
	{
		return n == "IDLE" || StringEndsWith(n, ".IDLE");
	}

	double RandomIdleHoldMs() { return FRandom(100, 600); }

	ui void SetFallbackTexture(String tex) { fallbackTex = tex; }

	ui String FallbackAnimName()
	{
		return (character.Length() > 0) ? (character .. ".FALLBACK") : "FALLBACK";
	}

	static int IndexOfStr(Array<String> arr, String s)
	{
		for (int i = 0; i < arr.Size(); i++) if (arr[i] == s) return i;
		return -1;
	}

	ui void Reset()
	{
		active = false;
		curClip = -1;
		seqPos = 0;
		timeLeftMs = 0;
		lastFrameIdx = -1;
		useTempSeq = false;
		tempCount = 0;
		pendingBlockSound = "";
		pendingBlockSoundMs = 0.0;
	}

	int EnsureFrameIndexByName(String name)
	{
		String wantLC = name.MakeLower();

		for (int i = 0; i < frames.Size(); i++)
		{
			if (frameNamesLower[i] == wantLC) return i;
		}

		TextureID id = TexMan.CheckForTexture(name, TexMan.Type_MiscPatch);
		if (!id.IsValid() && name != wantLC)
			id = TexMan.CheckForTexture(wantLC, TexMan.Type_MiscPatch);
		if (!id.IsValid()) return -1;

		frames.Push(id);
		frameNamesLower.Push(TexMan.GetName(id).MakeLower());
		return frames.Size() - 1;
	}

	ui String ApplyVariant(String base)
	{
		if (base.Length() == 0) return base;

		let cv = CVar.FindCVar('jm_anim_sexy_varni_enabled');
		if (!cv) return base;

		int v = cv.GetInt();

		if (v == 0) return base;
		if (v == 1)
		{
			EnsureRegistry();
			for (int i = 0; i < registryCharacters.Size(); i++)
			{
				String candidate = registryCharacters[i];
				if (Data("ATHM_" .. candidate .. "_VARIANT_OF").MakeUpper() == base.MakeUpper())
					return candidate;
			}
		}
			
		return base;
	}

	ui void EnsureCharacterForVoice(String voiceName)
	{
		String clear = (voiceName.RightIndexOf("/") >= 0)
			? voiceName.Mid(voiceName.RightIndexOf("/") + 1)
			: voiceName;

		String who = ResolveCharFromVoiceSmart(clear);
		who = ApplyVariant(who);
		if (who.Length() == 0)
		{
			character = "";
			return;
		}
		
		bool changed = (character != who);
		character = who;

		// BECAUSE!
		SetBackground(who);

		if (changed) InvalidateFallbackClips();

		if (IndexOfStr(loadedChars, who) < 0)
		{
			AnimRegistryLang.PreloadFor(self, who);
			AnimRegistryLang.RegisterFor(self, who, true);
			loadedChars.Push(who);
		}
	}

	ui void InvalidateFallbackClips()
	{
		int k = FindAnim("FALLBACK"); if (k >= 0) clipCount[k] = 0;

		for (int i = 0; i < loadedChars.Size(); i++)
		{
			String fb = loadedChars[i] .. ".FALLBACK";
			int j = FindAnim(fb); if (j >= 0) clipCount[j] = 0;
		}

		if (curClip >= 0)
		{
			String cur = animNames[curClip];
			if (StringEndsWith(cur, ".FALLBACK") || cur == "FALLBACK")
			{
				active = false; curClip = -1;
			}
		}
	}

	static double ScaleFromIdx(int idx)
	{
		switch (idx)
		{
			case 0: return 1.0;
			case 1: return 1.2;
			case 2: return 1.4;
			case 3: return 2.0;
			default: return 1.2;
		}
	}

	void ApplyScaleFromCVar()
	{
		int idx = 1;
		let cv = CVar.FindCVar('jm_anim_scale');
		if (cv) idx = clamp(cv.GetInt(), 0, 3);

		if (idx != cachedScaleIdx || vW == 0 || vH == 0)
		{
			double s = ScaleFromIdx(idx);
			vW = int(320 * s + 0.5);
			vH = int(200 * s + 0.5);
			topMargin = 0.0;
			cachedScaleIdx = idx;
		}
	}

	ui void PreloadOnce()
	{
		if (ready) return;

		useTempSeq = false;
		tempFrames.Clear(); tempDurMs.Clear(); tempLocked.Clear(); tempCount = 0;
		fbCacheName.Clear(); fbCacheOff.Clear();

		curClip = -1; seqPos = 0; timeLeftMs = 0.0;
		active = false; lastFrameIdx = -1;

		lastGoodFrameIdx = -1;

		cachedScaleIdx = -1;
		ApplyScaleFromCVar();

		ready = true;
	}

	ui void EnsureLiveScale() { ApplyScaleFromCVar(); }

	int PlaceholderFrameIndex()
	{
		if (lastGoodFrameIdx >= 0) return lastGoodFrameIdx;

		if (fallbackTex.Length() > 0)
		{
			int fi = EnsureFrameIndexByName(fallbackTex);
			if (fi >= 0) return fi;
		}

		int mi = EnsureFrameIndexByName("ANIM_MISSING");
		if (mi >= 0) return mi;

		return -1;
	}

	void DefineAnimation(String name, Array<int> fIdx, Array<double> durMs, bool loop=false, bool stopLast=true)
	{
		int n = min(fIdx.Size(), durMs.Size());
		if (n <= 0) return;

		int off = flatFrames.Size();
		for (int i = 0; i < n; i++)
		{
			flatFrames.Push(fIdx[i]);
			double ms = durMs[i]; if (ms <= 0) ms = 0.001;
			flatDurMs.Push(ms);
		}
		int cnt = flatFrames.Size() - off;
		if (cnt <= 0) return;

		int idx = FindAnim(name);
		if (idx >= 0)
		{
			clipOffset[idx] = off; clipCount[idx] = cnt;
			clipLoop[idx] = loop;  clipStopLast[idx] = stopLast;
		}
		else
		{
			animNames.Push(name);
			clipOffset.Push(off); clipCount.Push(cnt);
			clipLoop.Push(loop);  clipStopLast.Push(stopLast);
		}
	}

	ui void DefineAnimationV2(String name, String track, bool loop=false, bool stopLast=true, double durationMs=0, String background="")
	{
		int idx = FindAnim(name);
		if (idx < 0)
		{
			animNames.Push(name);
			clipOffset.Push(0); clipCount.Push(0);
			clipLoop.Push(loop); clipStopLast.Push(stopLast);
			idx = animNames.Size() - 1;
		}
		else
		{
			clipOffset[idx] = 0; clipCount[idx] = 0;
			clipLoop[idx] = loop; clipStopLast[idx] = stopLast;
		}
		while (clipIsTemplate.Size() <= idx) clipIsTemplate.Push(false);
		while (clipTplFrames.Size() <= idx) clipTplFrames.Push("");
		while (clipTplDurs.Size() <= idx) clipTplDurs.Push("");
		while (clipTplTrack.Size() <= idx) clipTplTrack.Push("");
		while (clipDurationMs.Size() <= idx) clipDurationMs.Push(0.0);
		while (clipBackground.Size() <= idx) clipBackground.Push("");
		clipIsTemplate[idx] = true;
		clipTplTrack[idx] = track;
		clipTplFrames[idx] = "";
		clipTplDurs[idx] = "";
		clipDurationMs[idx] = max(0.0, durationMs);
		clipBackground[idx] = background;
	}

	static String TrimWS(String src)
	{
		int first = 0, last = src.Length();
		while (first < last && IsWSByte(src.ByteAt(first))) first++;
		while (last > first && IsWSByte(src.ByteAt(last - 1))) last--;
		return src.Mid(first, last - first);
	}

	static String PickV2Choice(String spec)
	{
		spec = TrimWS(spec);
		int specLength = spec.Length();
		if (specLength >= 2 && spec.ByteAt(0) == 40 &&
			spec.ByteAt(specLength - 1) == 41)
		{
			spec = spec.Mid(1, specLength - 2);
			specLength = spec.Length();
		}

		int choices = 1;
		for (int i = 0; i < specLength; i++) if (spec.ByteAt(i) == 124) choices++;
		int pick = (choices > 1) ? int(FRandom(0.0, 1.0) * choices) : 0;
		if (pick >= choices) pick = choices - 1;
		int start = 0, current = 0;
		for (int i = 0; i <= specLength; i++)
		{
			if (i == specLength || spec.ByteAt(i) == 124)
			{
				if (current == pick) return TrimWS(spec.Mid(start, i - start));
				current++; start = i + 1;
			}
		}
		return TrimWS(spec);
	}

	ui bool AppendV2Segment(String token, bool locked, String blockSound="", double blockSoundOffsetMs=0.0)
	{
		token = TrimWS(token);
		if (token.Length() == 0) return false;
		int at = -1, parens = 0;
		int tokenLength = token.Length();
		for (int i = 0; i < tokenLength; i++)
		{
			int c = token.ByteAt(i);
			if (c == 40) parens++;
			else if (c == 41) parens--;
			else if (c == 64 && parens == 0) { at = i; break; }
		}
		if (at < 1)
		{
			Console.Printf("[ATHM] Invalid track segment '%s'. Expected FRAME@MILLISECONDS.\n", token);
			return false;
		}
		String frameName = PickV2Choice(token.Left(at));
		double duration = PickV2Choice(token.Mid(at + 1)).ToDouble();
		if (frameName.Length() == 0 || duration <= 0.0 || duration > 60000.0)
		{
			Console.Printf("[ATHM] Invalid frame or duration in segment '%s'.\n", token);
			return false;
		}
		if (tempCount >= 10000)
		{
			Console.Printf("[ATHM] Track exceeds the 10000 segment safety limit.\n");
			return false;
		}
		int fi = EnsureFrameIndexByName(frameName);
		if (fi < 0) fi = PlaceholderFrameIndex();
		if (fi >= 0) lastGoodFrameIdx = fi;
		tempFrames.Push(fi);
		tempDurMs.Push(duration);
		tempLocked.Push(locked);
		tempBlockSound.Push(blockSound);
		tempBlockSoundOffsetMs.Push(max(0.0, blockSoundOffsetMs));
		tempCount++;
		return true;
	}

	ui void AppendV2Segments(String source, bool locked, String blockSound="", double blockSoundOffsetMs=0.0)
	{
		int start = 0, parens = 0;
		bool first = true;
		int sourceLength = source.Length();
		for (int i = 0; i <= sourceLength; i++)
		{
			bool end = i == sourceLength;
			int c = end ? 0 : source.ByteAt(i);
			if (!end && c == 40) parens++;
			else if (!end && c == 41) parens--;
			if (end || (c == 59 && parens == 0))
			{
				AppendV2Segment(source.Mid(start, i - start), locked,
					first ? blockSound : "", first ? blockSoundOffsetMs : 0.0);
				first = false;
				start = i + 1;
			}
		}
	}

	ui bool ResolveV2TrackOnce(String source)
	{
		tempFrames.Clear(); tempDurMs.Clear(); tempLocked.Clear();
		tempBlockSound.Clear(); tempBlockSoundOffsetMs.Clear(); tempCount = 0;
		int start = 0, parens = 0, brackets = 0;
		bool invalidNesting = false;
		int sourceLength = source.Length();
		for (int i = 0; i <= sourceLength; i++)
		{
			bool end = i == sourceLength;
			int c = end ? 0 : source.ByteAt(i);
			if (!end && c == 40) parens++;
			else if (!end && c == 41) { parens--; if (parens < 0) invalidNesting = true; }
			else if (!end && c == 91) brackets++;
			else if (!end && c == 93) { brackets--; if (brackets < 0) invalidNesting = true; }
			if (end || (c == 59 && parens == 0 && brackets == 0))
			{
				String entry = TrimWS(source.Mid(start, i - start));
				bool locked = entry.Length() >= 2 && entry.ByteAt(0) == 91 &&
					entry.ByteAt(entry.Length() - 1) == 93;
				bool includeEntry = true;
				bool lockedContentsUnwrapped = false;
				String blockSound = "";
				double blockSoundOffsetMs = 0.0;
				if (entry.Length() >= 3 && entry.ByteAt(0) == 63)
				{
					int open = -1;
					int entryLength = entry.Length();
					for (int oi = 1; oi < entryLength; oi++)
					{
						if (entry.ByteAt(oi) == 91) { open = oi; break; }
					}
					if (open < 1 || entry.ByteAt(entry.Length() - 1) != 93)
					{
						Console.Printf("[ATHM] Invalid optional locked block '%s'.\n", entry);
						invalidNesting = true;
						includeEntry = false;
					}
					else
					{
						String prefix = TrimWS(entry.Mid(1, open - 1));
						int metadataOpen = -1;
						int prefixLength = prefix.Length();
						for (int mi = 0; mi < prefixLength; mi++)
						{
							if (prefix.ByteAt(mi) == 60) { metadataOpen = mi; break; }
						}
						String chanceText = prefix;
						if (metadataOpen >= 0)
						{
							if (prefix.ByteAt(prefix.Length() - 1) != 62)
							{
								Console.Printf("[ATHM] Invalid optional sound metadata: '%s'.\n", entry);
								invalidNesting = true;
								includeEntry = false;
							}
							else
							{
								chanceText = TrimWS(prefix.Left(metadataOpen));
								String metadata = TrimWS(prefix.Mid(metadataOpen + 1,
									prefix.Length() - metadataOpen - 2));
								int soundAt = -1;
								for (int si = metadata.Length() - 1; si >= 0; si--)
								{
									if (metadata.ByteAt(si) == 64) { soundAt = si; break; }
								}
								blockSound = TrimWS(soundAt < 0 ? metadata : metadata.Left(soundAt));
								if (soundAt >= 0)
									blockSoundOffsetMs = TrimWS(metadata.Mid(soundAt + 1)).ToDouble();
								if (blockSound.Length() == 0 || blockSoundOffsetMs < 0.0)
								{
									Console.Printf("[ATHM] Invalid optional block sound: '%s'.\n", entry);
									invalidNesting = true;
									includeEntry = false;
								}
							}
						}
						double chance = chanceText.Length() == 0 ? 50.0 : chanceText.ToDouble();
						if (chance <= 0.0 || chance > 100.0)
						{
							Console.Printf("[ATHM] Optional block chance must be in 0..100: '%s'.\n", entry);
							invalidNesting = true;
							includeEntry = false;
						}
						else
						{
							includeEntry = FRandom(0.0, 100.0) < chance;
						}
						entry = TrimWS(entry.Mid(open + 1, entry.Length() - open - 2));
						locked = true;
						lockedContentsUnwrapped = true;
					}
				}
				if (locked)
				{
					if (!lockedContentsUnwrapped)
						entry = TrimWS(entry.Mid(1, entry.Length() - 2));
					if (entry.Length() == 0)
					{
						Console.Printf("[ATHM] Empty locked block is not allowed.\n");
						invalidNesting = true;
					}
				}
				if (includeEntry) AppendV2Segments(entry, locked, blockSound, blockSoundOffsetMs);
				start = i + 1;
			}
		}
		if (parens != 0 || brackets != 0 || invalidNesting)
		{
			Console.Printf("[ATHM] Unbalanced parentheses or locked brackets in track.\n");
			tempFrames.Clear(); tempDurMs.Clear(); tempLocked.Clear();
			tempBlockSound.Clear(); tempBlockSoundOffsetMs.Clear(); tempCount = 0;
			return false;
		}
		return tempCount > 0;
	}

	ui void DefineAnimationTemplate(String name, String framesCsv, String dursCsv, bool loop=false, bool stopLast=true)
	{
		int idx = FindAnim(name);
		if (idx < 0)
		{
			animNames.Push(name);
			clipOffset.Push(0);
			clipCount.Push(0);
			clipLoop.Push(loop);
			clipStopLast.Push(stopLast);
			idx = animNames.Size() - 1;
		}
		else
		{
			clipOffset[idx] = 0;
			clipCount[idx]  = 0;
			clipLoop[idx]   = loop;
			clipStopLast[idx] = stopLast;
		}

		while (clipIsTemplate.Size() <= idx) clipIsTemplate.Push(false);
		while (clipTplFrames.Size() <= idx)  clipTplFrames.Push("");
		while (clipTplDurs.Size() <= idx)    clipTplDurs.Push("");
		while (clipTplTrack.Size() <= idx)   clipTplTrack.Push("");

		clipIsTemplate[idx] = true;
		clipTplFrames[idx]  = framesCsv;
		clipTplDurs[idx]    = dursCsv;
		clipTplTrack[idx]   = "";
	}

	void DefineAnimationByNames(String name, Array<String> fNames, Array<double> durMs, bool loop=false, bool stopLast=true)
	{
		Array<int> idx;
		Array<double> durs;
		int n = min(fNames.Size(), durMs.Size());

		for (int i = 0; i < n; i++)
		{
			int fi = EnsureFrameIndexByName(fNames[i]);
			double ms = durMs[i]; if (ms <= 0) ms = 0.001;

			if (fi < 0) fi = PlaceholderFrameIndex();
			if (fi >= 0) lastGoodFrameIdx = fi;

			idx.Push(fi);
			durs.Push(ms);
		}

		if (idx.Size() == 0) return;
		DefineAnimation(name, idx, durs, loop, stopLast);
	}

	static String GetAnimationName(String path, String separator = "/")
	{
		int pos = path.RightIndexOf(separator);
		return (pos >= 0) ? path.Mid(pos + 1) : path;
	}

	static bool IsWSByte(int c)
	{
		return (c == 32 /*space*/ || c == 9 /*\t*/ || c == 13 /*\r*/ || c == 10 /*\n*/);
	}

	static void ParseChoiceGroupsNames(String src,
		Array<String> alts, Array<int> posStart, Array<int> posLen)
	{
		alts.Clear(); posStart.Clear(); posLen.Clear();

		bool inGroup = false;

		int tokenStart = -1;

		int groupStart = 0;
		int groupCount = 0;

		int len = src.Length();

		for (int i = 0; i <= len; i++)
		{
			bool end = (i == len);
			int c = end ? 0 : src.ByteAt(i);

			bool ws   = (!end && IsWSByte(c));
			bool sep  = (!end && (c == 44 /*,*/ || c == 59 /*;*/));
			bool lpar = (!end && (c == 40 /*(*/));
			bool rpar = (!end && (c == 41 /*)*/));

			bool delim = end || ws || sep || lpar || rpar;

			if (!delim)
			{
				if (tokenStart < 0) tokenStart = i;
				continue;
			}

			// flush token
			if (tokenStart >= 0)
			{
				String tok = src.Mid(tokenStart, i - tokenStart);
				alts.Push(tok);

				if (inGroup)
				{
					groupCount++;
				}
				else
				{
					int start = alts.Size() - 1;
					posStart.Push(start);
					posLen.Push(1);
				}

				tokenStart = -1;
			}

			if (end) break;

			if (lpar)
			{
				// start group
				inGroup = true;
				groupStart = alts.Size();
				groupCount = 0;
			}
			else if (rpar)
			{
				// end group
				if (inGroup)
				{
					if (groupCount > 0)
					{
						posStart.Push(groupStart);
						posLen.Push(groupCount);
					}
					inGroup = false;
				}
			}
			// sep/ws just separate tokens; nothing else
		}

		// unclosed group: finalize it
		if (inGroup && groupCount > 0)
		{
			posStart.Push(groupStart);
			posLen.Push(groupCount);
		}
	}

	static void ParseChoiceGroupsFloats(String src,
		Array<double> alts, Array<int> posStart, Array<int> posLen)
	{
		alts.Clear(); posStart.Clear(); posLen.Clear();

		Array<String> altsS;
		Array<int>    sStart, sLen;

		ParseChoiceGroupsNames(src, altsS, sStart, sLen);

		for (int i = 0; i < altsS.Size(); i++)
			alts.Push(altsS[i].ToDouble());

		for (int i = 0; i < sStart.Size(); i++)
		{
			posStart.Push(sStart[i]);
			posLen.Push(sLen[i]);
		}
	}

	ui bool ResolveTemplateOnce(int clipIdx)
	{
		if (clipIdx < 0 || clipIdx >= animNames.Size()) return false;
		if (!(clipIsTemplate.Size() > clipIdx && clipIsTemplate[clipIdx])) return false;
		if (clipTplTrack.Size() > clipIdx && clipTplTrack[clipIdx].Length() > 0)
		{
			if (!ResolveV2TrackOnce(clipTplTrack[clipIdx])) return false;
			return PadResolvedSequenceToDuration(clipIdx);
		}

		String sF = clipTplFrames[clipIdx];
		String sD = clipTplDurs[clipIdx];

		Array<String> fAlts; Array<int> fStart; Array<int> fLen;
		ParseChoiceGroupsNames(sF, fAlts, fStart, fLen);

		Array<double> dAlts; Array<int> dStart; Array<int> dLen;
		ParseChoiceGroupsFloats(sD, dAlts, dStart, dLen);

		int positions = min(fStart.Size(), dStart.Size());
		if (positions <= 0) return false;

		tempFrames.Clear();
		tempDurMs.Clear();
		tempLocked.Clear();
		tempCount = 0;

		for (int i = 0; i < positions; i++)
		{
			int fs = fStart[i], fl = fLen[i];
			int ds = dStart[i], dl = dLen[i];

			int pickF = (fl > 1) ? (fs + int(FRandom(0.0, 1.0) * fl)) : fs;
			if (pickF >= fs + fl) pickF = fs + fl - 1;

			int pickD = ds;
			if (dl > 1)
			{
				pickD = ds + int(FRandom(0.0, 1.0) * dl);
				if (pickD >= ds + dl) pickD = ds + dl - 1;
			}

			String fName = fAlts[pickF];
			double dur   = dAlts[pickD];
			if (dur <= 0.0) dur = 0.001;

			int fi = EnsureFrameIndexByName(fName);
			if (fi < 0) fi = PlaceholderFrameIndex();
			if (fi >= 0) lastGoodFrameIdx = fi;

			tempFrames.Push(fi);
			tempDurMs.Push(dur);
			tempCount++;
		}

		return PadResolvedSequenceToDuration(clipIdx);
	}

	ui bool PadResolvedSequenceToDuration(int clipIdx)
	{
		if (tempCount <= 0) return false;
		if (clipIdx < 0 || clipIdx >= clipDurationMs.Size()) return true;
		double wanted = clipDurationMs[clipIdx];
		if (wanted <= 0.0) return true;

		double actual = 0.0;
		for (int i = 0; i < tempDurMs.Size(); i++) actual += tempDurMs[i];
		if (actual + 0.001 < wanted)
		{
			tempFrames.Push(tempFrames[tempCount - 1]);
			tempDurMs.Push(wanted - actual);
			tempLocked.Push(false);
			tempBlockSound.Push("");
			tempBlockSoundOffsetMs.Push(0.0);
			tempCount++;
		}
		return true;
	}

	ui bool EnsureFallbackAnim()
	{
		String fbName = FallbackAnimName();
		int animIdx = FindAnim(fbName);

		// If no backdrop specified, rely on existing FALLBACK clip if present
		if (fallbackTex.Length() == 0)
			return (animIdx >= 0 && clipCount[animIdx] > 0);

		int fi = EnsureFrameIndexByName(fallbackTex);
		if (fi < 0)
			return (animIdx >= 0 && clipCount[animIdx] > 0);

		// Find or create cached slot for this fallback name
		int c = FindFbCache(fbName);
		if (c < 0)
		{
			fbCacheName.Push(fbName);
			fbCacheOff.Push(-1);
			c = fbCacheName.Size() - 1;
		}

		int off = fbCacheOff[c];
		if (off < 0)
		{
			// first time: allocate one slot
			off = flatFrames.Size();
			flatFrames.Push(fi);
			flatDurMs.Push(3600000.0);
			fbCacheOff[c] = off;
		}
		else
		{
			// subsequent times: overwrite (no growth)
			flatFrames[off] = fi;
			flatDurMs[off]  = 3600000.0;
		}

		// Ensure animation record points to our cached slot
		if (animIdx >= 0)
		{
			clipOffset[animIdx]   = off;
			clipCount[animIdx]    = 1;
			clipLoop[animIdx]     = true;
			clipStopLast[animIdx] = true;
		}
		else
		{
			animNames.Push(fbName);
			clipOffset.Push(off);
			clipCount.Push(1);
			clipLoop.Push(true);
			clipStopLast.Push(true);
		}

		return true;
	}


	ui void OnConversationEnd()
	{
		// keep loadedChars cached for next conversation speed
		character = "";
		InvalidateFallbackClips();
	}

	ui bool PlayFallback()
	{
		if (!EnsureFallbackAnim()) return false;
		return PlayAnim(FallbackAnimName());
	}

	ui bool PlayForVoice(String voiceName)
	{
		EnsureCharacterForVoice(voiceName);

		if (character.Length() > 0)
		{
			String clip = resolvedAnimation.Length() > 0
				? resolvedAnimation : NormalizeSoundName(voiceName);
			if (PlayAnimChar(clip)) return true;
			if (PlayAnimChar("IDLE")) return true;
		}

		if (PlayAnim("IDLE")) 
		{
			return true;
		}
		return PlayFallback();
	}

	ui bool CanDraw()
	{
		if (active && curClip >= 0)
		{
			if (useTempSeq && tempCount > 0) return true;
			if (!useTempSeq && clipCount[curClip] > 0) return true;
		}

		if (lastFrameIdx >= 0) return true;

		if (character.Length() > 0 && FindAnim(character .. ".IDLE") >= 0) return true;
		if (FindAnim("IDLE") >= 0) return true;

		int i = FindAnim(FallbackAnimName());
		return (i >= 0 && clipCount[i] > 0);
	}

	ui void PadCurrentSequenceToDuration(double wantedMs)
	{
		if (!active || !useTempSeq || tempCount <= 0 || wantedMs <= 0.0) return;

		double actualMs = 0.0;
		for (int i = 0; i < tempCount; i++) actualMs += tempDurMs[i];
		if (actualMs + 0.001 >= wantedMs) return;

		tempFrames.Push(tempFrames[tempCount - 1]);
		tempDurMs.Push(wantedMs - actualMs);
		tempLocked.Push(false);
		tempBlockSound.Push("");
		tempBlockSoundOffsetMs.Push(0.0);
		tempCount++;
	}

	ui void ArmOptionalBlockSound()
	{
		if (!useTempSeq || seqPos < 0 || seqPos >= tempBlockSound.Size()) return;
		String sound = tempBlockSound[seqPos];
		if (sound.Length() == 0) return;
		pendingBlockSound = sound;
		pendingBlockSoundMs = tempBlockSoundOffsetMs[seqPos];
		if (pendingBlockSoundMs <= 0.0)
		{
			DialogUIOverlay.PlayOptionalBlockSoundStatic(pendingBlockSound);
			pendingBlockSound = "";
		}
	}

	ui void TickOptionalBlockSound(double dt)
	{
		if (pendingBlockSound.Length() == 0) return;
		pendingBlockSoundMs -= dt;
		if (pendingBlockSoundMs <= 0.0)
		{
			DialogUIOverlay.PlayOptionalBlockSoundStatic(pendingBlockSound);
			pendingBlockSound = "";
		}
	}

	ui bool PlayAnim(String name)
	{
		PreloadOnce();
		pendingBlockSound = "";
		pendingBlockSoundMs = 0.0;

		int idx = FindAnim(GetAnimationName(name));
		if (idx < 0) return false;

		if (clipIsTemplate.Size() > idx && clipIsTemplate[idx])
		{
			if (!ResolveTemplateOnce(idx)) return false;

			curClip = idx; active = true; seqPos = 0; useTempSeq = true;
			ApplyBackgroundForClip(idx);

			timeLeftMs = tempDurMs[0];
			if (timeLeftMs <= 0) timeLeftMs = 1;

			if (IsIdleName(GetAnimationName(name).MakeUpper()) &&
				!(idx < clipDurationMs.Size() && clipDurationMs[idx] > 0.0))
				timeLeftMs += RandomIdleHoldMs();

			lastFrameIdx = tempFrames[0];
			if (lastFrameIdx >= 0) lastGoodFrameIdx = lastFrameIdx;
			ArmOptionalBlockSound();
			return true;
		}

		if (clipCount[idx] <= 0) return false;

		curClip = idx; active = true; seqPos = 0; useTempSeq = false;
		ApplyBackgroundForClip(idx);

		int base = clipOffset[idx];
		timeLeftMs = flatDurMs[base];
		if (timeLeftMs <= 0) timeLeftMs = 1;

		if (IsIdleName(GetAnimationName(name).MakeUpper()))
			timeLeftMs += RandomIdleHoldMs();

		lastFrameIdx = flatFrames[base];
		if (lastFrameIdx >= 0) lastGoodFrameIdx = lastFrameIdx;
		return true;
	}

	ui bool PlayAnimChar(String name)
	{
		String realName = GetAnimationName(name).MakeUpper();
		PreloadOnce();

		if (character.Length() > 0)
		{
			String full = character .. "." .. realName;
			if (FindAnim(full) >= 0) return PlayAnim(full);
		}
		return PlayAnim(realName);
	}

	ui bool TryStartIdle()
	{
		if (character.Length() > 0 && FindAnim(character .. ".IDLE") >= 0)
			return PlayAnimChar("IDLE");
		if (FindAnim("IDLE") >= 0)
			return PlayAnim("IDLE");
		return false;
	}

	ui void Tick()
	{
		if (!active || curClip < 0) return;

		int cnt = useTempSeq ? tempCount : clipCount[curClip];
		if (cnt <= 0) { active = false; return; }

		double dt = 1000.0 / TICRATE;
		TickOptionalBlockSound(dt);
		timeLeftMs -= dt;

		while (timeLeftMs <= 0.0)
		{
			seqPos++;

			if (seqPos >= cnt)
			{
				if (clipLoop[curClip])
				{
					if (useTempSeq)
					{
						if (!ResolveTemplateOnce(curClip))
						{
							active = false;
							return;
						}
						// Optional blocks can change the resolved sequence size on
						// every loop. Never keep the previous pass' frame count.
						cnt = tempCount;
					}
					seqPos = 0;
				}
				else
				{
					String curName = animNames[curClip];
					bool wasIdle = (curName == "IDLE") ||
						(character.Length() > 0 && curName == character .. ".IDLE");
					bool wasFallback = (curName == "FALLBACK") || StringEndsWith(curName, ".FALLBACK");

					active = false;

					// stopLast ALWAYS TRUE: keep last frame
					{
						int last = cnt - 1;
						lastFrameIdx = useTempSeq
							? tempFrames[last]
							: flatFrames[clipOffset[curClip] + last];

						if (lastFrameIdx >= 0) lastGoodFrameIdx = lastFrameIdx;
					}

					if (!wasIdle && !wasFallback)
					{
						if (TryStartIdle()) return;
					}
					return;
				}
			}

			if (useTempSeq)
			{
				timeLeftMs += tempDurMs[seqPos];
				lastFrameIdx = tempFrames[seqPos];
			}
			else
			{
				int base = clipOffset[curClip] + seqPos;
				timeLeftMs += flatDurMs[base];
				lastFrameIdx = flatFrames[base];
			}

			if (lastFrameIdx >= 0) lastGoodFrameIdx = lastFrameIdx;
			if (useTempSeq) ArmOptionalBlockSound();
		}
	}

	ui bool TrySetBackgroundTexture(String name)
	{
		bgName = name;
		if (name.Length() == 0)
		{
			bgTexture = TexMan.CheckForTexture("", TexMan.Type_MiscPatch);
			return false;
		}
		
		bgTexture = TexMan.CheckForTexture(name, TexMan.Type_MiscPatch);
		if (!bgTexture.IsValid())
		{
			bgTexture = TexMan.CheckForTexture(name);
		}
		return bgTexture.IsValid();
	}

	ui void SetBackground(String who)
	{
		characterBgName = Data("ATHM_" .. who .. "_BACKGROUND");
		TrySetBackgroundTexture(characterBgName);
	}

	ui void ApplyBackgroundForClip(int idx)
	{
		String selected = "";
		if (idx >= 0 && idx < clipBackground.Size())
			selected = clipBackground[idx];

		if (selected.MakeLower() == "@none")
		{
			TrySetBackgroundTexture("");
			return;
		}

		if (selected.Length() > 0 && TrySetBackgroundTexture(selected))
			return;

		TrySetBackgroundTexture(characterBgName);
	}

	ui void DrawTexture(TextureID tex, int x, int y, int vW, int vH)
	{
		Screen.DrawTexture(tex, false, x, y,
			DTA_VirtualWidth,  vW,
			DTA_VirtualHeight, vH,
			DTA_KeepRatio, true,
			DTA_TopLeft, true
		);	
	}

	ui void Draw()
	{
		int drawIdx = lastFrameIdx;

		if (active && curClip >= 0)
		{
			int cnt = useTempSeq ? tempCount : clipCount[curClip];
			if (cnt > 0 && seqPos >= 0 && seqPos < cnt)
			{
				drawIdx = useTempSeq
					? tempFrames[seqPos]
					: flatFrames[clipOffset[curClip] + seqPos];
			}
		}

		if (drawIdx < 0 || drawIdx >= frames.Size()) return;

		TextureID tex = frames[drawIdx];
		if (!tex.IsValid()) return;

		Vector2 sz = TexMan.GetScaledSize(tex);
		double x = (vW - sz.x) * 0.5;
		double y = (vH - sz.y) * 0.25;

		// if background is there, draw it
		if (bgTexture.IsValid()) {
			DrawTexture(bgTexture, x, y, vW, vH);
		}
		
		// draw animation frame
		DrawTexture(tex, x, y, vW, vH);
	}

	int FindAnim(String n)
	{
		for (int i = 0; i < animNames.Size(); i++)
			if (animNames[i] == n) return i;
		return -1;
	}

	bool IsStopped()
	{
		if (!active || curClip < 0) return true;
		if (useTempSeq) return (tempCount <= 0);
		return (clipCount[curClip] <= 0);
	}

	ui bool IsLocked()
	{
		return active && useTempSeq && seqPos >= 0 && seqPos < tempLocked.Size()
			&& tempLocked[seqPos];
	}

	int CurrentFrameIndex()
	{
		if (active && curClip >= 0)
		{
			if (useTempSeq)
			{
				if (tempCount > 0 && seqPos >= 0 && seqPos < tempCount) return tempFrames[seqPos];
			}
			else
			{
				int count = clipCount[curClip];
				if (count > 0 && seqPos >= 0 && seqPos < count)
					return flatFrames[clipOffset[curClip] + seqPos];
			}
		}
		return lastFrameIdx;
	}

	String CurrentAnimationName()
	{
		return (curClip >= 0 && curClip < animNames.Size()) ? animNames[curClip] : "";
	}
}
