
/////////////////////////////////////////////////////////////////////////
// ---- I don't even know, something about sound ----
// ---- to make everything quieter when in dialog----
/////////////////////////////////////////////////////////////////////////

class DialogAudioDuck : StaticEventHandler
{
    // Состояние
    ui bool active;             // внутри "диалога"
    ui bool changed;            // реально меняли громкость (выше порога)
    ui bool pendingDuck;        // сигналы из UI -> выполнить в WorldTick
    ui bool pendingRestore;

    // Настройки
    ui double threshold; // если пользовательская музыка <= 0.30 — не трогаем
    ui double factor; // во сколько раз приглушить (0..2)

    // Цель для ACS (fixed 16.16)
    ui int targetVol16;

    // Найти хендлер
    ui static DialogAudioDuck Get()
    {
        return DialogAudioDuck(StaticEventHandler.Find("DialogAudioDuck"));
    }

    // ===== ПУБЛИЧНЫЕ ВЫЗОВЫ ИЗ UI-КОДА =====

    // Начать "дакинг". Можно передать другой фактор (например, 0.5).
    ui static void BeginStatic(double factorOverride = -1.0)
    {

        let d = Get(); if (!d) return;
		
		d.threshold = 0.30; // если пользовательская музыка <= 0.30 — не трогаем
		d.factor    = 0.35; // во сколько раз приглушить (0..2)

        if (factorOverride > 0.0) d.factor = clamp(factorOverride, 0.0, 2.0);
        if (d.active) return;           // уже активны — игнорируем повтор

        d.active  = true;
        d.changed = false;

        // Проверяем пользовательскую громкость музыки (читаем CVAR — это можно)
        double userMusic = 1.0;
        let cv = CVar.GetCVar('snd_musicvolume', players[consoleplayer]);
        if (cv) userMusic = clamp(cv.GetFloat(), 0.0, 1.0);

        d.changed     = (userMusic > d.threshold);         // будем ли вообще что-то менять
        d.targetVol16 = int(d.factor * 65536.0 + 0.5);     // fixed 16.16
        d.pendingDuck = true;                              // выполнить в WorldTick
    }

    // Завершить "дакинг" (вернуть громкость)
    ui static void EndStatic()
    {
        let d = Get(); if (!d) return;
        if (!d.active) return;
        d.pendingRestore = true;
    }

    // ===== PLAY-КОНТЕКСТ =====

    override void WorldTick()
    {
        // Старт приглушения
        if (pendingDuck)
        {
            pendingDuck = false;

            if (changed)
            {
                // применяем множитель factor относительно пользовательского уровня
                ACS_ScriptCall('Dlg_SetMusicVol', targetVol16);   // vol 0..2 in 16.16
				console.printf("music level now: %.2f", targetVol16);

            }
        }

        // Возврат громкости
        if (pendingRestore)
        {
            pendingRestore = false;

            if (changed)
            {
                ACS_ScriptCall('Dlg_SetMusicVol', 65536);  // 1.0 в fixed 16.16
				console.printf("music level now: %.2f", 65536);

            }

            changed = false;
            active  = false;
        }
    }

    // На всякий случай: если уровень выгружается — вернём музыку
//     override void WorldUnloaded()
//     {
//         if (active && changed)
//         {
//             ACS_ScriptCall('Dlg_SetMusicVol', 65536);
//         }
//         active = false; changed = false;
//         pendingDuck = pendingRestore = false;
//     }
}
