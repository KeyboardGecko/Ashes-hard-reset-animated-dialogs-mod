    // --- helpers ---
		
	int PlaceholderFrameIndex()
	// Вернуть индекс кадра-плейсхолдера, чтобы сохранить тайминг.
	// Порядок приоритетов:
	// 1) последний успешно выбранный кадр в текущей temp-последовательности,
	// 2) fallbackTex (если задан и валиден),
	// 3) специальная картинка "ANIM_MISSING" (если положите её в WAD/PK3),
	// 4) иначе -1 (ничего не рисуем, но длительность сохраняем).
	{
		// 1) последний успешный temp-кадр
		if (useTempSeq && tempFrames.Size() > 0) {
			int k = tempFrames[tempFrames.Size() - 1];
			if (k >= 0) return k;
		}

		// 2) fallbackTex
		if (fallbackTex.Length() > 0) {
			int fi = EnsureFrameIndexByName(fallbackTex);
			if (fi >= 0) return fi;
		}

		// 3) специальная текстура (добавьте в ресурс при желании)
		int mi = EnsureFrameIndexByName("ANIM_MISSING");
		if (mi >= 0) return mi;

		// 4) пусто — позволим рендеру ничего не рисовать, но время останется
		return -1;
	}
	

	void DefineAnimation(String name, Array<int> fIdx, Array<double> durMs, bool loop=false, bool stopLast=true)
	{
		int n = min(fIdx.Size(), durMs.Size());
		if (n <= 0) return;

		int off = flatFrames.Size();
		for (int i = 0; i < n; i++)
		{
			int fi = fIdx[i];
			// кладём как есть; отрисовка проверит валидность позже
			flatFrames.Push(fi);
			double ms = durMs[i]; if (ms <= 0) ms = 0.001;
			flatDurMs.Push(ms);
		}
		int cnt = flatFrames.Size() - off;
		if (cnt <= 0) return;

		int idx = FindAnim(name);
		if (idx >= 0) {
			clipOffset[idx] = off; clipCount[idx] = cnt;
			clipLoop[idx] = loop;  clipStopLast[idx] = stopLast;
		} else {
			animNames.Push(name);
			clipOffset.Push(off); clipCount.Push(cnt);
			clipLoop.Push(loop);  clipStopLast.Push(stopLast);
		}
	}

	ui void DefineAnimationTemplate(String name, String framesCsv, String dursCsv, bool loop=false, bool stopLast=true)
	{
		int idx = FindAnim(name);
		if (idx >= 0)
		{
			clipOffset[idx]   = 0;
			clipCount[idx]    = 0;
			clipLoop[idx]     = loop;
			clipStopLast[idx] = stopLast;

			// ENSURE SIZE ≥ idx+1
			while (clipIsTemplate.Size() <= idx) clipIsTemplate.Push(false);
			while (clipTplFrames.Size() <= idx)  clipTplFrames.Push("");
			while (clipTplDurs.Size() <= idx)    clipTplDurs.Push("");

			clipIsTemplate[idx] = true;
			clipTplFrames[idx]  = framesCsv;
			clipTplDurs[idx]    = dursCsv;
		}
		else
		{
			animNames.Push(name);
			clipOffset.Push(0);
			clipCount.Push(0);
			clipLoop.Push(loop);
			clipStopLast.Push(stopLast);

			int newIdx = animNames.Size() - 1;

			// ENSURE SIZE ≥ newIdx+1
			while (clipIsTemplate.Size() <= newIdx) clipIsTemplate.Push(false);
			while (clipTplFrames.Size() <= newIdx)  clipTplFrames.Push("");
			while (clipTplDurs.Size() <= newIdx)    clipTplDurs.Push("");

			clipIsTemplate[newIdx] = true;
			clipTplFrames[newIdx]  = framesCsv;
			clipTplDurs[newIdx]    = dursCsv;
		}
	}


	void DefineAnimationByNames(String name, Array<String> fNames, Array<double> durMs, bool loop=false, bool stopLast=true)
	{
		Array<int> idx;
		Array<double> durs;
		int n = min(fNames.Size(), durMs.Size());

		for (int i = 0; i < n; i++)
		{
			int fi = EnsureFrameIndexByName(fNames[i]);
			double ms = durMs[i]; if (ms <= 0) ms = 0.001;

			if (fi < 0) {
				fi = PlaceholderFrameIndex();   // <-- берём плейсхолдер
			}
			// КЛАДЁМ ВСЕГДА, даже если fi == -1: тайминг сохраняется
			idx.Push(fi);
			durs.Push(ms);
		}

		if (idx.Size() == 0) return;
		DefineAnimation(name, idx, durs, loop, stopLast);
	}


	static String GetAnimationName(String path, String separator = "/")
	{
		int pos = path.RightIndexOf(separator);
		return (pos >= 0) ? path.Mid(pos + 1) : path;
	}

	// (A,B,C),X,(Y,Z),W  →  alts=["A","B","C","X","Y","Z","W"]
	// posStart=[0,3,4,6], posLen=[3,1,2,1]
	static void ParseChoiceGroupsNames(String src,
		Array<String> alts, Array<int> posStart, Array<int> posLen)
	{
		alts.Clear(); posStart.Clear(); posLen.Clear();

		String cur = "";
		bool inGroup = false;
		Array<String> group;

		int len = int(src.Length());
		for (int i = 0; i < len; i++)
		{
			String ch = src.Mid(i, 1);

			if (ch == "(")
			{
				// завершить одиночный токен перед группой
				if (cur.Length() > 0)
				{
					int start = alts.Size();
					alts.Push(cur);
					posStart.Push(start);
					posLen.Push(1);
					cur = "";
				}
				inGroup = true;
				group.Clear();
			}
			else if (ch == ")")
			{
				if (inGroup)
				{
					if (cur.Length() > 0) { group.Push(cur); cur = ""; }
					if (group.Size() > 0)
					{
						int start = alts.Size();
						for (int g = 0; g < group.Size(); g++) alts.Push(group[g]);
						posStart.Push(start);
						posLen.Push(group.Size());
					}
					inGroup = false;
				}
				else
				{
					// лишняя ) — считаем частью токена
					cur = cur .. ch;
				}
			}
			else if (ch == "," || ch == ";")
			{
				if (inGroup)
				{
					if (cur.Length() > 0) { group.Push(cur); cur = ""; }
				}
				else
				{
					if (cur.Length() > 0)
					{
						int start = alts.Size();
						alts.Push(cur);
						posStart.Push(start);
						posLen.Push(1);
						cur = "";
					}
				}
			}
			else if (ch == " " || ch == "\t" || ch == "\r" || ch == "\n")
			{
				// игнор пробелов
			}
			else
			{
				cur = cur .. ch;
			}
		}

		if (inGroup)
		{
			if (cur.Length() > 0) group.Push(cur);
			if (group.Size() > 0)
			{
				int start = alts.Size();
				for (int g = 0; g < group.Size(); g++) alts.Push(group[g]);
				posStart.Push(start);
				posLen.Push(group.Size());
			}
		}
		else
		{
			if (cur.Length() > 0)
			{
				int start = alts.Size();
				alts.Push(cur);
				posStart.Push(start);
				posLen.Push(1);
			}
		}
	}

	static void ParseChoiceGroupsFloats(String src,
		Array<double> alts, Array<int> posStart, Array<int> posLen)
	{
		alts.Clear(); posStart.Clear(); posLen.Clear();

		// Парсим как имена, затем преобразуем в числа
		Array<String> altsS;
		Array<int>    sStart, sLen;

		ParseChoiceGroupsNames(src, altsS, sStart, sLen);

		for (int i = 0; i < altsS.Size(); i++)
			alts.Push(altsS[i].ToDouble());

		for (int i = 0; i < sStart.Size(); i++)
		{
			posStart.Push(sStart[i]);
			posLen.Push(sLen[i]);
		}
	}

