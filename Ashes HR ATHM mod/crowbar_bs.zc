ACTOR Crowbar_BS : Crowbar replaces Crowbar
{
  States
  {
  // --- Ready с понижением ---
  Ready:
    TNT1 A 0 A_JumpIfInventory("lightlit", 1, "ReadyLantern_BS")
    TNT1 A 0 A_JumpIfInventory("BackstabberReady", 1, "ReadyLowered")
    Goto Super::Ready

  ReadyLowered:
    // опускаем на ~полспрайта; подстрой значение (16–24)
    TNT1 A 0 A_WeaponOffset(0, 18)
    CROW A 1 A_WeaponReady(WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
    Loop

  // --- Ready для фонаря с понижением ---
  ReadyLantern_BS:
    TNT1 A 0 A_JumpIfInventory("BackstabberReady", 1, "ReadyLanternLowered")
    Goto Super::ReadyLantern

  ReadyLanternLowered:
    TNT1 A 0 A_WeaponOffset(0, 18)
    SOLR A 1 BRIGHT A_WeaponReady(WRF_ALLOWUSER3|WRF_ALLOWUSER2|WRF_ALLOWUSER1)
    Loop

  // --- Перехват Fire: если ready — запускаем бэкстаб; иначе — в родной Fire ---
  Fire:
    TNT1 A 0 A_JumpIfInventory("lightlit", 1, "FireLantern_BS")
    TNT1 A 0 A_JumpIfInventory("BackstabberReady", 1, "DoBackstab")
    Goto Super::Fire

  FireLantern_BS:
    TNT1 A 0 A_JumpIfInventory("BackstabberReady", 1, "DoBackstab")
    Goto Super::FireLantern

  DoBackstab:
    TNT1 A 0 A_UseInventory("Backstabber") // вызовет твой Use(); он сам решит — даш/удар/кд
    Goto Ready
  }
}

ACTOR Crowbar2_BS : Crowbar2 replaces Crowbar2
{
  States
  {
  Ready:
    TNT1 A 0 A_JumpIfInventory("lightlit", 1, "ReadyLantern2_BS")
    TNT1 A 0 A_JumpIfInventory("BackstabberReady", 1, "Ready2Lowered")
    Goto Super::Ready

  Ready2Lowered:
    TNT1 A 0 A_WeaponOffset(0, 18)
    C2OW A 1 A_WeaponReady(WRF_ALLOWUSER1|WRF_ALLOWUSER2|WRF_ALLOWUSER3)
    Loop

  ReadyLantern2_BS:
    TNT1 A 0 A_JumpIfInventory("BackstabberReady", 1, "ReadyLantern2Lowered")
    Goto Super::ReadyLantern

  ReadyLantern2Lowered:
    TNT1 A 0 A_WeaponOffset(0, 18)
    S2LR A 1 BRIGHT A_WeaponReady(WRF_ALLOWUSER3|WRF_ALLOWUSER2|WRF_ALLOWUSER1)
    Loop

  Fire:
    TNT1 A 0 A_JumpIfInventory("lightlit", 1, "FireLantern2_BS")
    TNT1 A 0 A_JumpIfInventory("BackstabberReady", 1, "DoBackstab2")
    Goto Super::Fire

  FireLantern2_BS:
    TNT1 A 0 A_JumpIfInventory("BackstabberReady", 1, "DoBackstab2")
    Goto Super::FireLantern

  DoBackstab2:
    TNT1 A 0 A_UseInventory("Backstabber")
    Goto Ready
  }
}
